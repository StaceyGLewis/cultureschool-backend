async function renderBoards(email){
  let query = db
    .from('cocoboards')
    .select('id, title, subtitle, hero_image_url, banner_url, event_date, show_on_profile')
    .eq('creator_email', email)
    .is('deleted_at', null)
    .order('created_at', { ascending: false })
    .limit(30);

  // Public view: only show boards marked visible
  if(!isOwnProfile) query = query.eq('show_on_profile', true);

  const { data: boards } = await query;
  if(!boards || !boards.length) return;

  const divHtml = `
    <div class="divider anim">
      <div class="divider-line"></div>
      <span class="divider-gem">◈</span>
      <div class="divider-text">Collections</div>
      <span class="divider-gem">◈</span>
      <div class="divider-line"></div>
    </div>`;

  function buildCard(b){
    const shown   = b.show_on_profile !== false; // default true if null
    const img     = b.hero_image_url || b.banner_url || '';
    const url     = `https://showcase-viewer.cultureschool.org/?board_id=${encodeURIComponent(b.id)}`;
    const imgHtml = img
      ? `<img class="board-card-img" src="${esc(img)}" alt="${esc(b.title||'')}" loading="lazy">`
      : `<div class="board-card-empty">✦</div>`;

    const footer = isOwnProfile ? `
      <div class="board-card-footer">
        <button
          class="board-vis-btn ${shown?'shown':'hidden'}"
          data-board-id="${esc(b.id)}"
          data-shown="${shown}"
          onclick="event.preventDefault();toggleBoardVisibility(this)"
          title="${shown?'Visible on your profile — click to hide':'Hidden from your profile — click to show'}">
          ${shown ? '● Shown' : '○ Hidden'}
        </button>
        <a href="${esc(url)}" target="_blank" rel="noopener"
           style="font:.7rem/1 'DM Sans',sans-serif;color:var(--gold-dk);text-decoration:none;"
           onclick="event.stopPropagation()">Open →</a>
      </div>` : '';

    return `
      <div class="board-card ${shown?'':'is-hidden'}" data-board-id="${esc(b.id)}">
        <a href="${esc(url)}" target="_blank" rel="noopener" style="display:block;text-decoration:none;color:inherit">
          ${imgHtml}
        </a>
        <div class="board-card-body">
          <div class="board-card-title">${esc(b.title||'Untitled Collection')}</div>
          ${b.subtitle   ? `<div class="board-card-sub">${esc(b.subtitle)}</div>` : ''}
          ${b.event_date ? `<div class="board-card-sub" style="margin-top:4px;color:var(--gold-dk)">📅 ${esc(b.event_date)}</div>` : ''}
          ${footer}
        </div>
      </div>`;
  }

  document.getElementById('boardsMount').innerHTML = divHtml + `
    <div class="boards-wrap anim anim-1">
      <div class="boards-grid">${boards.map(buildCard).join('')}</div>
    </div>`;
}

async function toggleBoardVisibility(btn){
  const boardId  = btn.dataset.boardId;
  const wasShown = btn.dataset.shown === 'true';
  const nowShown = !wasShown;

  // Optimistic UI
  btn.dataset.shown   = nowShown;
  btn.className       = `board-vis-btn ${nowShown?'shown':'hidden'}`;
  btn.textContent     = nowShown ? '● Shown' : '○ Hidden';
  btn.title           = nowShown ? 'Visible on your profile — click to hide' : 'Hidden from your profile — click to show';
  const card = document.querySelector(`.board-card[data-board-id="${boardId}"]`);
  if(card) card.classList.toggle('is-hidden', !nowShown);

  const { error } = await db
    .from('cocoboards')
    .update({ show_on_profile: nowShown })
    .eq('id', boardId);

  if(error){
    // Revert on failure
    btn.dataset.shown  = wasShown;
    btn.className      = `board-vis-btn ${wasShown?'shown':'hidden'}`;
    btn.textContent    = wasShown ? '● Shown' : '○ Hidden';
    if(card) card.classList.toggle('is-hidden', !wasShown);
    showToast('Couldn\'t update — try again');
  }
}

