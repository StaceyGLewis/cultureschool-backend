async function renderStats(email){
  if(!isOwnProfile) return;

  // Post count — always works
  const postsRes = await db
    .from('inspo_wall')
    .select('row_id', {count:'exact', head:true})
    .eq('email', email)
    .eq('is_public', true);

  const postCount = postsRes.count || 0;
  const views     = CREATOR?.profile_views || 0;

  // Notification count — fails gracefully if table doesn't exist yet
  let notifCount = 0;
  try {
    const notifRes = await db
      .from('creator_notifications')
      .select('id', {count:'exact', head:true})
      .eq('creator_email', email)
      .eq('read', false);
    notifCount = notifRes.count || 0;
  } catch(_){}

  document.getElementById('statsMount').innerHTML = `
    <div class="stats-bar anim anim-2">
      <div class="stat-card">
        <div class="stat-num">${postCount}</div>
        <div class="stat-label">Moments</div>
      </div>
      <div class="stat-card">
        <div class="stat-num">${views}</div>
        <div class="stat-label">Profile views</div>
      </div>
      <div class="stat-card stat-card-clickable ${notifCount>0?'stat-card-alert':''}" onclick="toggleNotifications()">
        <div class="stat-num">${notifCount}</div>
        <div class="stat-label">Notifications</div>
        ${notifCount>0?'<div class="stat-dot"></div>':''}
      </div>
    </div>`;
}

