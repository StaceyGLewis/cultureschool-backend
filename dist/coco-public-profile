══════════════════════════════════════════════════════ */
function isVideo(url){
  return url && /\.(mp4|mov|webm|ogg)(\?|$)/i.test(url);
}

async function renderPosts(email){
  const { data: posts } = await db
    .from('inspo_wall')
    .select('row_id, title, image, caption, type, tags, featured_at, source_url')
    .eq('email', email)
    .eq('is_public', true)
    .order('featured_at', { ascending: false })
    .limit(30);

  const divHtml = `
    <div class="divider anim">
      <div class="divider-line"></div>
      <span class="divider-gem">◈</span>
      <div class="divider-text">Moments</div>
      <span class="divider-gem">◈</span>
      <div class="divider-line"></div>
    </div>`;

  if(!posts || !posts.length){
    document.getElementById('postsMount').innerHTML = divHtml + `
      <div class="posts-wrap anim anim-1">
        ${isOwnProfile
          ? `<div class="posts-grid">
              <div class="post-card post-card-empty" onclick="openModal('shareModal')">
                <div class="post-placeholder">
                  <span>✦</span>
                  <span class="post-placeholder-label">Share your first moment</span>
                </div>
              </div>
            </div>`
          : `<div class="empty-state">No moments shared yet.</div>`}
      </div>`;
    return;
  }

  const cards = posts.map(p => {
    const imgUrl = p.image || p.source_url || '';
    let media;
    if(!imgUrl){
      media = `<div class="post-placeholder"><span>✦</span></div>`;
    } else if(isVideo(imgUrl)){
      media = `<video src="${esc(imgUrl)}" autoplay muted loop playsinline></video>
               <div class="post-video-badge">▶ Video</div>`;
    } else {
      media = `<img src="${esc(imgUrl)}" alt="${esc(p.type||'')}" loading="lazy">`;
    }
    const deleteBtn = isOwnProfile
      ? `<button class="post-delete" onclick="deletePost('${esc(p.row_id)}',event)" title="Delete post">✕</button>`
      : '';
    return `
      <div class="post-card">
        ${media}
        ${deleteBtn}
        <div class="post-overlay">
          ${p.type    ? `<div class="post-occasion">${esc(p.type)}</div>` : ''}
          ${p.caption ? `<div class="post-caption">${esc(p.caption)}</div>` : ''}
        </div>
      </div>`;
  }).join('');

  document.getElementById('postsMount').innerHTML = divHtml + `
    <div class="posts-wrap anim anim-1">
      <div class="posts-grid">${cards}</div>
    </div>`;
}

async function deletePost(rowId, e){
  e.stopPropagation();
  if(!confirm('Remove this post from your profile?')) return;

  const { error } = await db
    .from('inspo_wall')
    .delete()
    .eq('row_id', rowId)
    .eq('email', signedInEmail);

  if(error){ showToast('Could not delete — try again'); console.error(error); return; }

  showToast('Post removed', false);
  await renderPosts(signedInEmail);
  await renderStats(signedInEmail);
}

