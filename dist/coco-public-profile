async function uploadProfilePhoto(e, type){
  const file = e.target.files[0];
  if(!file) return;

  const zone    = document.getElementById(type === 'avatar' ? 'avatarUpload' : 'coverUpload');
  const overlay = zone.querySelector('.photo-overlay');
  zone.classList.add('uploading');
  overlay.textContent = 'Uploading…';

  try {
    const ext    = file.name.split('.').pop() || 'jpg';
    const folder = type === 'avatar' ? 'creator-avatars' : 'creator-covers';
    const path   = `${folder}/${signedInEmail}/${Date.now()}.${ext}`;

    const { data, error: upErr } = await db.storage
      .from('public-uploads')
      .upload(path, file, { cacheControl: '3600', upsert: true });
    if(upErr) throw upErr;

    const { data: urlData } = db.storage.from('public-uploads').getPublicUrl(data.path);
    const url = urlData.publicUrl;

    // Update DB immediately
    const col     = type === 'avatar' ? 'avatar_url' : 'cover_image';
    const { error: dbErr } = await db.from('creators').update({ [col]: url }).eq('email', signedInEmail);
    if(dbErr) throw dbErr;

    // Update local state and preview
    CREATOR[col] = url;
    if(type === 'avatar'){
      zone.querySelector('img,div.avatar-empty').outerHTML = `<img src="${url}" alt="Avatar" style="width:80px;height:80px;border-radius:50%;object-fit:cover;border:2px solid var(--line)">`;
    } else {
      zone.querySelector('img,div.cover-empty').outerHTML = `<img src="${url}" alt="Cover" style="width:100%;height:100%;object-fit:cover;display:block">`;
    }

    // Refresh hero
    renderHero(CREATOR);
    showToast(type === 'avatar' ? 'Profile photo updated ✦' : 'Cover updated ✦', true);

  } catch(err){
    console.error('[photo upload]', err);
    showToast('Upload failed — try again');
  } finally {
    zone.classList.remove('uploading');
    overlay.textContent = type === 'avatar' ? '📷 Change' : '📷 Change cover';
  }
}

async function saveProfile(){
  const updates = {
    display_name: document.getElementById('eName').value.trim()    || null,
    location:     document.getElementById('eLocation').value.trim()|| null,
    bio:          document.getElementById('eBio').value.trim()     || null,
    website:      document.getElementById('eWebsite').value.trim() || null,
    link:         document.getElementById('eLink').value.trim()    || null,
  };
  const { error } = await db.from('creators').update(updates).eq('email', CREATOR.email);
  if(error){ showToast('Save failed — try again'); console.error(error); return; }
  Object.assign(CREATOR, updates);
  renderHero(CREATOR);
  toggleEditPanel();
  showToast('Profile updated ✦', true);
}

/* ══════════════════════════════════════════════════════
   SIGN IN
══════════════════════════════════════════════════════ */
async function doSignIn(){
  const email = (document.getElementById('signInEmail').value || '').trim().toLowerCase();
  const btn   = document.querySelector('#signInModal .modal-btn-post');

  if(!email || !email.includes('@') || !email.includes('.')){
    showToast('Enter a valid email address'); return;
  }

  btn.textContent = 'Signing in…';
  btn.disabled    = true;

  try {
    localStorage.setItem('userEmail',   email);
    localStorage.setItem('USER_EMAIL',  email);
    closeModal('signInModal');
    // location.origin is "null" on file:// — use href split instead
    const base = location.href.split('?')[0];
    location.href = base + '?email=' + encodeURIComponent(email);
  } catch(err){
    console.error('[signIn]', err);
    showToast('Something went wrong — try again');
    btn.textContent = 'Enter →';
    btn.disabled    = false;
  }
}
function copyProfileLink(){
  const base = location.href.split('?')[0];
  const url  = base + '?email=' + encodeURIComponent(CREATOR.email);
  if(navigator.share){ navigator.share({ title: (CREATOR.display_name||'CoCo Creator') + ' on CoCo', url }); }
  else { navigator.clipboard.writeText(url).then(()=>showToast('Link copied ✦', true)); }
}

/* ══════════════════════════════════════════════════════
   PROFILE VIEW TRACKING
══════════════════════════════════════════════════════ */
async function recordProfileView(email){
  if(isOwnProfile) return;
  // Debounce: only record once per session per profile
  const key = 'pv_' + email;
  if(sessionStorage.getItem(key)) return;
  sessionStorage.setItem(key, '1');
  await db.rpc('increment_profile_views', { creator_email: email })
    .catch(() => {
      // Fallback if RPC doesn't exist yet: direct increment
      db.from('creators')
        .update({ profile_views: (CREATOR?.profile_views||0) + 1 })
        .eq('email', email);
    });
}

/* ══════════════════════════════════════════════════════
   NOTIFICATIONS — saves, inquiries, claps unified
══════════════════════════════════════════════════════ */
let notifOpen = false;

async function toggleNotifications(){
  const mount = document.getElementById('inquiriesMount');
  if(notifOpen){ mount.innerHTML = ''; notifOpen = false; return; }
  notifOpen = true;
  mount.innerHTML = `<div class="inbox-wrap"><div class="inbox-card"><div class="inbox-header"><span class="inbox-title">Notifications</span><span class="inbox-close" onclick="toggleNotifications()">✕ Close</span></div><div class="inbox-empty">Loading…</div></div></div>`;

  const [notifRes, inqRes, myListingsRes] = await Promise.all([
    db.from('creator_notifications').select('*').eq('creator_email',signedInEmail).order('created_at',{ascending:false}).limit(20),
    db.from('creator_inquiries').select('*').eq('creator_email',signedInEmail).order('created_at',{ascending:false}).limit(10),
    db.from('listings').select('id,title,listing_type,listing_responses(id,responder_email,created_at)').eq('poster_email',signedInEmail).eq('status','open'),
  ]);

  // Mark notifications read
  db.from('creator_notifications').update({read:true}).eq('creator_email',signedInEmail).eq('read',false);

  const notifs    = notifRes.data || [];
  const inquiries = inqRes.data   || [];

  // Flatten listing responses from all of this creator's listings
  const listingResps = (myListingsRes.data || []).flatMap(listing =>
    (listing.listing_responses || []).map(r => ({ ...r, listing }))
  ).sort((a,b) => new Date(b.created_at) - new Date(a.created_at)).slice(0,10);

  if(!notifs.length && !inquiries.length && !listingResps.length){
    mount.innerHTML = `<div class="inbox-wrap"><div class="inbox-card"><div class="inbox-header"><span class="inbox-title">Notifications</span><span class="inbox-close" onclick="toggleNotifications()">✕ Close</span></div><div class="inbox-empty">Nothing yet — when someone saves or inquires, it shows up here.</div></div></div>`;
    return;
  }

  function typeIcon(t){ return t==='save'?'⊕ Collected': t==='clap'?'♡ Liked': t==='inquiry'?'✉ Inquired': t==='listing_response'?'✦ Interested':'✦'; }
  function timeAgo(ts){
    const d = Date.now() - new Date(ts).getTime();
    const m = Math.floor(d/60000), h = Math.floor(m/60), dy = Math.floor(h/24);
    if(dy>0) return dy+'d ago'; if(h>0) return h+'h ago'; if(m>0) return m+'m ago'; return 'just now';
  }

  const notifItems = notifs.map(n => `
    <div class="inq-item ${n.read?'':'unread'}">
      <div class="inq-item-top">
        <div class="inq-sender">${typeIcon(n.type)}</div>
        <div class="inq-time">${timeAgo(n.created_at)}</div>
      </div>
      ${n.actor_location ? `<div class="inq-email">📍 ${esc(n.actor_location)}</div>` : ''}
      <div class="inq-message">${
        n.type==='save'
          ? `Someone collected your post${n.post_title?' <em>"${esc(n.post_title)}"</em>':''}${n.actor_location?' from '+esc(n.actor_location):''}.`
          : n.type==='clap'
          ? `Someone liked your post${n.post_title?' <em>"${esc(n.post_title)}"</em>':''}.`
          : n.type==='listing_response'
          ? `Someone is interested in your listing${n.post_title?' <em>"${esc(n.post_title)}"</em>':''}.`
          : esc(n.message||'New notification')
      }</div>
      ${n.post_image ? `<img src="${esc(n.post_image)}" style="width:60px;height:60px;object-fit:cover;border-radius:8px;margin-top:8px;border:1px solid var(--line)">` : ''}
    </div>`).join('');

  const inqItems = inquiries.map(inq => `
    <div class="inq-item ${inq.read?'':'unread'}">
      <div class="inq-item-top">
        <div class="inq-sender">✉ ${esc(inq.sender_name||'Someone')} wants to work with you</div>
        <div class="inq-time">${timeAgo(inq.created_at)}</div>
      </div>
      <div class="inq-email">${esc(inq.sender_email||'')}</div>
      <div class="inq-message">${esc(inq.message||'')}</div>
      <a class="inq-reply-btn" href="mailto:${esc(inq.sender_email||'')}?subject=Re: Your inquiry via CoCo">Reply →</a>
    </div>`).join('');

  const listingRespItems = listingResps.map(r => {
    const responderName = r.responder_email.split('@')[0]
      .replace(/[._-]+/g,' ').replace(/\w/g, x => x.toUpperCase());
    const profileUrl = 'https://coco-public-profile.cultureschool.org/?email='
      + encodeURIComponent(r.responder_email);
    const typeLabel = r.listing.listing_type === 'available' ? '◉ Available' : '✦ Looking For';
    return `
    <div class="inq-item unread">
      <div class="inq-item-top">
        <div class="inq-sender">✦ Interested in your listing</div>
        <div class="inq-time">${timeAgo(r.created_at)}</div>
      </div>
      <div class="inq-message">
        <em>${esc(r.listing.title)}</em>
        <span style="display:block;margin-top:3px;font-size:.75em;opacity:.6;">${typeLabel}</span>
      </div>
      <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;">
        <a class="inq-reply-btn" href="${esc(profileUrl)}" target="_blank" rel="noopener">View their profile →</a>
        <a class="inq-reply-btn" href="mailto:${esc(r.responder_email)}?subject=Re: Your interest in my CoCo listing&body=Hi, I saw you expressed interest in my listing — ${esc(r.listing.title)}." style="background:transparent;border:1px solid var(--line);">Email them →</a>
      </div>
    </div>`;
  }).join('');

  const totalCount = notifs.length + inquiries.length + listingResps.length;

  mount.innerHTML = `
    <div class="inbox-wrap">
      <div class="inbox-card">
        <div class="inbox-header">
          <span class="inbox-title">Notifications · ${totalCount}</span>
          <span class="inbox-close" onclick="toggleNotifications()">✕ Close</span>
        </div>
        ${listingResps.length ? `
          <div class="inbox-section-label">Listing Responses</div>
          ${listingRespItems}
        ` : ''}
        ${notifs.length || inquiries.length ? `
          <div class="inbox-section-label" style="margin-top:${listingResps.length?'14px':'0'}">Activity</div>
          ${notifItems}${inqItems}
        ` : ''}
      </div>
    </div>`;

  await renderStats(signedInEmail);
}

