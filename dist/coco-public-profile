            </p>
            <button class="hero-btn hero-btn-ghost" style="margin-top:20px" onclick="signOut()">Sign out</button>
          </div>`;
        return;
      }
      CREATOR = newRow;
    }

    if(!CREATOR){
      hideLoader();
      document.getElementById('heroMount').innerHTML = `
        <div style="text-align:center;padding:80px 20px">
          <p style="font-family:'Cormorant Garamond',serif;font-style:italic;color:var(--ink-dim);font-size:1.1rem">Creator profile not found.</p>
        </div>`;
      return;
    }

    renderHero(CREATOR);
    renderClaimBanner(CREATOR);
    renderSharePrompt(CREATOR);
    renderAvailPanel(CREATOR);
    recordProfileView(CREATOR.email);

    await Promise.all([
      renderStats(CREATOR.email),
      renderPosts(CREATOR.email),
      renderTemplates(CREATOR.email),
      renderBoards(CREATOR.email),
    ]);

  } catch(err){
    console.error('[boot]', err);
    hideLoader();
    document.getElementById('heroMount').innerHTML = `
      <div style="text-align:center;padding:80px 20px">
        <p style="font-family:'Cormorant Garamond',serif;font-style:italic;color:var(--ink-dim);font-size:1.1rem">
