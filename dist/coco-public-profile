function renderHero(c){
  const name = c.display_name || c.username || (c.email||'').split('@')[0];
  const cover = c.cover_image||c.preview_image
    ? `<img class="hero-cover" src="${esc(c.cover_image||c.preview_image)}" alt=""><div class="hero-cover-fade"></div>`
    : `<div class="hero-cover-empty">✦</div><div class="hero-cover-fade"></div>`;
  const avatar = (c.avatar_url||c.profile_pic)
    ? `<img class="hero-avatar" src="${esc(c.avatar_url||c.profile_pic)}" alt="${esc(name)}">`
    : `<div class="hero-avatar-empty">${esc(name.charAt(0).toUpperCase())}</div>`;
  const isOpen = !!c.available_for_hire;
  const availHtml = `<div class="avail-badge ${isOpen?'avail-badge-open':'avail-badge-closed'}">
    <span class="avail-dot"></span>
    ${isOpen ? 'Open for projects' : 'Not taking projects'}
  </div>`;
  const chips = (c.available_for||[]).map(a=>`<span class="chip">${esc(a)}</span>`).join('');
  const social = [
    c.website   && `<a class="social-dot" href="${esc(c.website)}"   target="_blank" rel="noopener" title="Website">🌐</a>`,
    c.instagram && `<a class="social-dot" href="${esc(c.instagram)}" target="_blank" rel="noopener" title="Instagram">📸</a>`,
    c.link      && `<a class="social-dot" href="${esc(c.link)}"      target="_blank" rel="noopener" title="Link">✨</a>`,
  ].filter(Boolean).join('');

  const publicActions = !isOwnProfile ? `
    ${isOpen?`<button class="hero-btn hero-btn-gold" onclick="openModal('inquiryModal')">✦ Inquire</button>`:''}
    <button class="hero-btn hero-btn-ghost" onclick="copyProfileLink()">↗ Share</button>` : '';
  const ownerActions = isOwnProfile ? `
    <button class="hero-btn hero-btn-gold" onclick="openModal('shareModal')">✦ Share a moment</button>
    <a class="hero-btn hero-btn-ghost" href="?email=${encodeURIComponent(c.email)}" target="_blank">Preview →</a>` : '';

  document.getElementById('heroMount').innerHTML = `
    <div class="hero anim">
      ${cover}
      <div class="hero-body">
        <div class="hero-identity anim">
          ${avatar}
          <div class="hero-name-block">
            <div class="hero-name">${esc(name)}</div>
            ${c.location?`<div class="hero-location">📍 ${esc(c.location)}</div>`:''}
          </div>
        </div>
        ${social?`<div class="hero-social anim anim-1">${social}</div>`:''}
        <div class="anim anim-1">${availHtml}</div>
        ${chips?`<div class="hero-chips anim anim-1">${chips}</div>`:''}
        ${c.bio?`<div class="hero-bio anim anim-2">${esc(c.bio)}</div>`:''}
        <div class="hero-actions anim anim-3">${publicActions}${ownerActions}</div>
      </div>
    </div>`;
  document.title = name + ' · CoCo';
}

