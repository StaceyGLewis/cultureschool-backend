        document.getElementById('heroMount').innerHTML = `
          <div style="text-align:center;padding:80px 20px;max-width:480px;margin:0 auto">
            <p style="font-family:'Cormorant Garamond',serif;font-style:italic;color:var(--ink-dim);font-size:1.1rem;line-height:1.7">
