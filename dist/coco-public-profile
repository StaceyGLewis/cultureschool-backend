
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>CoCo · Creator Hub</title>
<meta name="theme-color" content="#0d0a07">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Pinyon+Script&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<!--
  ══════════════════════════════════════════════════════
  SUPABASE TABLE NEEDED (run once):

  CREATE TABLE IF NOT EXISTS creator_posts (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    creator_email text NOT NULL,
    image_url text,
    caption text,
    occasion text,
    palette_code text,
    hearts_count integer DEFAULT 0,
    views_count integer DEFAULT 0,
    created_at timestamptz DEFAULT now()
  );
  ALTER TABLE creator_posts ENABLE ROW LEVEL SECURITY;
  CREATE POLICY "public read" ON creator_posts FOR SELECT USING (true);
  CREATE POLICY "creator insert" ON creator_posts FOR INSERT
    WITH CHECK (creator_email = current_setting('request.jwt.claims', true)::json->>'email');

  CREATE TABLE IF NOT EXISTS creator_inquiries (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    creator_email text NOT NULL,
    sender_name text,
    sender_email text,
    message text,
    occasion text,
    created_at timestamptz DEFAULT now(),
    read boolean DEFAULT false
  );
  ══════════════════════════════════════════════════════
-->

<style>
:root {
  --gold:      #c8a050;
  --gold-lt:   #e8d4a0;
  --gold-dk:   #8a6820;
  --ink:       #faf6f0;
  --ink-soft:  #a89070;
  --ink-dim:   #5a4a38;
  --paper:     #0d0a07;
  --surface:   #181410;
  --surface-2: #221e18;
  --surface-3: #2e2820;
  --glass:     rgba(30,24,16,.88);
  --line:      rgba(200,160,80,.15);
  --line-soft: rgba(200,160,80,.08);
  --ok:        #6fba8a;
  --ease:      cubic-bezier(.22,.61,.36,1);
  --radius:    14px;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: 'DM Sans', sans-serif;
  background: var(--paper);
  color: var(--ink);
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}
/* Grain */
body::before {
  content: ''; position: fixed; inset: 0; z-index: 1000;
  pointer-events: none; opacity: .025;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-size: 256px;
}
a { color: inherit; text-decoration: none; }
button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }
img { display: block; }

/* ══ CLAIM BANNER ═════════════════════════════════════ */
.claim-banner {
  background: linear-gradient(135deg, rgba(200,160,80,.12), rgba(200,160,80,.06));
  border-bottom: 1px solid rgba(200,160,80,.2);
  padding: 14px clamp(16px,4vw,36px);
  display: flex; align-items: center; justify-content: space-between;
  gap: 14px; flex-wrap: wrap;
  animation: fadeUp .4s var(--ease) both;
}
.claim-banner-text {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic; font-size: .95rem;
  color: var(--ink-soft); line-height: 1.5;
}
.claim-banner-text strong { color: var(--gold); font-style: normal; }
.claim-btn {
  padding: 9px 20px; border-radius: 999px; flex-shrink: 0;
  background: linear-gradient(135deg,var(--gold-dk),var(--gold));
  color: #1e1610; font: 700 .63rem/1 'DM Sans',sans-serif;
  letter-spacing: .1em; text-transform: uppercase;
  transition: all .2s; cursor: pointer;
}
.claim-btn:hover { filter: brightness(1.08); transform: translateY(-1px); }
.topbar {
  position: sticky; top: 0; z-index: 200;
  padding: calc(env(safe-area-inset-top,0px) + 12px) clamp(16px,4vw,36px) 12px;
  background: linear-gradient(to bottom, rgba(13,10,7,.97) 75%, transparent);
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
}
.topbar-logo {
  font-family: 'Pinyon Script', cursive;
  font-size: 1.6rem; line-height: 1; color: var(--gold);
  text-shadow: 0 0 20px rgba(200,160,80,.28);
}
.topbar-right { display: flex; align-items: center; gap: 10px; }
.topbar-btn {
  padding: 7px 16px; border-radius: 999px;
  border: 1px solid var(--line); background: var(--glass);
  backdrop-filter: blur(12px);
  font: 600 .63rem/1 'DM Sans',sans-serif;
  letter-spacing: .1em; text-transform: uppercase;
  color: var(--ink-soft); transition: all .2s;
}
.topbar-btn:hover { border-color: var(--gold); color: var(--gold); }
.topbar-btn-primary {
  background: linear-gradient(135deg,var(--gold-dk),var(--gold));
  border-color: transparent; color: #1e1610;
}
.topbar-btn-primary:hover { filter: brightness(1.08); color: #1e1610; }

/* ══ HERO ══════════════════════════════════════════════════ */
.hero { position: relative; animation: fadeUp .55s var(--ease) both; }
.hero-cover {
  width: 100%; height: clamp(160px,24vw,280px);
  object-fit: cover; filter: brightness(.65) saturate(.85);
}
.hero-cover-empty {
  width: 100%; height: clamp(160px,24vw,280px);
  background: linear-gradient(135deg,var(--surface),var(--surface-2));
  display: flex; align-items: center; justify-content: center;
  font-family: 'Pinyon Script',cursive; font-size: 5rem;
  color: var(--gold); opacity: .18;
}
.hero-cover-fade {
  position: absolute; top: 0; left: 0; right: 0;
  height: clamp(160px,24vw,280px);
  background: linear-gradient(to bottom, transparent 35%, rgba(13,10,7,.85) 100%);
  pointer-events: none;
}
.hero-body {
  max-width: 860px; margin: 0 auto;
  padding: 0 clamp(16px,4vw,36px);
  position: relative;
}
.hero-identity {
  display: flex; align-items: flex-end; gap: 18px;
  margin-top: -48px; margin-bottom: 16px;
}
.hero-avatar {
  width: 90px; height: 90px; border-radius: 50%;
  object-fit: cover; flex-shrink: 0;
  border: 3px solid var(--gold);
  box-shadow: 0 0 0 4px rgba(200,160,80,.14), 0 8px 24px rgba(0,0,0,.5);
}
.hero-avatar-empty {
  width: 90px; height: 90px; border-radius: 50%;
  background: var(--surface-2); border: 3px solid var(--gold);
  box-shadow: 0 0 0 4px rgba(200,160,80,.14); flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-family: 'Pinyon Script',cursive; font-size: 2.2rem; color: var(--gold);
}
.hero-name-block { padding-bottom: 4px; }
.hero-name {
  font-family: 'Pinyon Script',cursive;
  font-size: clamp(2rem,5.5vw,3rem); line-height: .95;
  color: var(--ink); text-shadow: 0 2px 18px rgba(0,0,0,.5);
}
.hero-location {
  font: 500 .7rem/1 'DM Sans',sans-serif;
  letter-spacing: .07em; color: var(--ink-dim); margin-top: 5px;
}
.hero-social {
  display: flex; gap: 9px; margin-top: 12px; flex-wrap: wrap;
}
.social-dot {
  width: 34px; height: 34px; border-radius: 50%;
  background: var(--surface-2); border: 1px solid var(--line);
  display: flex; align-items: center; justify-content: center;
  font-size: .88rem; transition: all .2s;
}
.social-dot:hover { border-color: var(--gold); transform: translateY(-2px); }

/* Availability badge */
.avail-badge {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 5px 14px; border-radius: 999px;
  font: 600 .62rem/1 'DM Sans',sans-serif;
  letter-spacing: .1em; text-transform: uppercase;
  margin-top: 12px;
}
.avail-badge-open {
  background: rgba(111,186,138,.12);
  border: 1px solid rgba(111,186,138,.3);
  color: var(--ok);
}
.avail-badge-closed {
  background: rgba(255,255,255,.04);
  border: 1px solid var(--line);
  color: var(--ink-dim);
}
.avail-dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: currentColor; flex-shrink: 0;
}
.avail-badge-open .avail-dot { animation: pulse 2s ease-in-out infinite; }
@keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.45;transform:scale(.65)} }

.hero-chips {
  display: flex; gap: 7px; flex-wrap: wrap; margin-top: 10px;
}
.chip {
  padding: 5px 12px; border-radius: 999px;
  background: rgba(200,160,80,.1);
  border: 1px solid rgba(200,160,80,.24);
  font: 600 .59rem/1 'DM Sans',sans-serif;
  letter-spacing: .1em; text-transform: uppercase;
  color: var(--gold-dk);
}
.hero-bio {
  margin-top: 16px; padding-top: 16px;
  border-top: 1px solid var(--line-soft);
  font-family: 'Cormorant Garamond',serif;
  font-style: italic; font-weight: 300;
  font-size: clamp(.9rem,1.8vw,1.02rem);
  color: var(--ink-soft); line-height: 1.75; max-width: 580px;
}
.hero-actions {
  display: flex; gap: 8px; flex-wrap: wrap; margin-top: 18px;
}
.hero-btn {
  padding: 9px 20px; border-radius: 999px;
  font: 600 .63rem/1 'DM Sans',sans-serif;
  letter-spacing: .1em; text-transform: uppercase; transition: all .2s;
}
.hero-btn-gold {
  background: linear-gradient(135deg,var(--gold-dk),var(--gold));
  color: #1e1610; box-shadow: 0 4px 16px rgba(200,160,80,.24);
}
.hero-btn-gold:hover { transform: translateY(-1px); box-shadow: 0 6px 22px rgba(200,160,80,.36); }
.hero-btn-ghost {
  background: var(--surface-2); border: 1px solid var(--line); color: var(--ink-soft);
}
.hero-btn-ghost:hover { border-color: var(--gold); color: var(--gold); }

/* ══ DASHBOARD STATS BAR ═══════════════════════════════════ */
.stats-bar {
  max-width: 860px; margin: 28px auto 0;
  padding: 0 clamp(16px,4vw,36px);
  display: grid; grid-template-columns: repeat(4,1fr); gap: 10px;
}
.stat-card {
  background: var(--surface); border: 1px solid var(--line-soft);
  border-radius: var(--radius); padding: 16px 18px;
  text-align: center;
}
.stat-num {
  font-family: 'Cormorant Garamond',serif;
  font-size: 2rem; font-weight: 300; color: var(--gold);
  line-height: 1;
}
.stat-label {
  font: 600 .58rem/1 'DM Sans',sans-serif;
  letter-spacing: .14em; text-transform: uppercase;
  color: var(--ink-dim); margin-top: 5px;
}
@media (max-width:560px) { .stats-bar { grid-template-columns: 1fr 1fr; } }
.stat-card-clickable { cursor: pointer; transition: border-color .2s, background .2s; }
.stat-card-clickable:hover { border-color: rgba(200,160,80,.3); background: var(--surface-2); }
.stat-card-alert { border-color: rgba(111,186,138,.3); }
.stat-card-alert .stat-num { color: var(--ok); }
.stat-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--ok); margin: 4px auto 0;
  animation: pulse 2s ease-in-out infinite;
}

/* ══ INQUIRIES INBOX ══════════════════════════════════════ */
.inbox-wrap {
  max-width: 860px; margin: 0 auto 8px;
  padding: 0 clamp(16px,4vw,36px);
}
.inbox-card {
  background: var(--surface); border: 1px solid var(--line-soft);
  border-radius: var(--radius); overflow: hidden;
  animation: fadeUp .3s var(--ease) both;
}
.inbox-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 18px; border-bottom: 1px solid var(--line-soft);
}
.inbox-title {
  font: 700 .68rem/1 'DM Sans',sans-serif;
  letter-spacing: .14em; text-transform: uppercase; color: var(--gold);
}
.inbox-close {
  font-size: .75rem; color: var(--ink-dim); cursor: pointer;
  padding: 4px 8px; border-radius: 6px; transition: color .15s;
}
.inbox-close:hover { color: var(--ink); }
.inq-item {
  padding: 16px 18px; border-bottom: 1px solid var(--line-soft);
  transition: background .15s;
}
.inq-item:last-child { border-bottom: none; }
.inq-item.unread { background: rgba(200,160,80,.04); }
.inq-item-top {
  display: flex; align-items: flex-start; justify-content: space-between; gap: 12px;
  margin-bottom: 7px;
}
.inq-sender {
  font: 600 .78rem/1 'DM Sans',sans-serif; color: var(--ink);
}
.inq-time {
  font: 400 .63rem/1 'DM Sans',sans-serif; color: var(--ink-dim); white-space: nowrap;
}
.inq-email {
  font: 400 .68rem/1 'DM Sans',sans-serif; color: var(--gold-dk); margin-bottom: 8px;
}
.inq-message {
  font-family: 'Cormorant Garamond',serif; font-style: italic;
  font-size: .9rem; color: var(--ink-soft); line-height: 1.65;
}
.inq-reply-btn {
  margin-top: 10px; padding: 6px 14px; border-radius: 999px;
  background: none; border: 1px solid var(--line);
  font: 600 .6rem/1 'DM Sans',sans-serif; letter-spacing: .1em;
  text-transform: uppercase; color: var(--ink-dim);
  cursor: pointer; transition: all .2s; text-decoration: none; display: inline-block;
}
.inq-reply-btn:hover { border-color: var(--gold); color: var(--gold); }
.inbox-section-label {
  font: 700 .58rem/1 var(--sans);
  letter-spacing: .16em; text-transform: uppercase;
  color: rgba(200,160,80,.55);
  padding: 10px 0 8px;
  border-bottom: 1px solid var(--line);
  margin-bottom: 4px;
}

.inbox-empty {
  padding: 28px; text-align: center;
  font-family: 'Cormorant Garamond',serif;
  font-style: italic; color: var(--ink-dim); font-size: .9rem;
}

/* ══ SHARE MOMENT BUTTON ═══════════════════════════════════ */
.share-bar {
  max-width: 860px; margin: 20px auto 0;
  padding: 0 clamp(16px,4vw,36px);
}
.share-prompt {
  width: 100%; padding: 16px 22px;
  background: var(--surface); border: 1px solid var(--line);
  border-radius: 999px; cursor: pointer;
  display: flex; align-items: center; justify-content: space-between;
  transition: border-color .2s, background .2s;
}
.share-prompt:hover { border-color: rgba(200,160,80,.4); background: var(--surface-2); }
.share-prompt-text {
  font-family: 'Cormorant Garamond',serif;
  font-style: italic; font-size: 1rem; color: var(--ink-dim);
}
.share-prompt-icon {
  width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0;
  background: linear-gradient(135deg,var(--gold-dk),var(--gold));
  display: flex; align-items: center; justify-content: center;
  font-size: .75rem; color: #1e1610; font-weight: 700;
}

/* ══ AVAILABILITY TOGGLE (dashboard) ══════════════════════ */
.avail-panel {
  max-width: 860px; margin: 20px auto 0;
  padding: 0 clamp(16px,4vw,36px);
}
.avail-row {
  display: flex; align-items: center; justify-content: space-between;
  background: var(--surface); border: 1px solid var(--line-soft);
  border-radius: var(--radius); padding: 16px 20px; gap: 16px;
  flex-wrap: wrap;
}
.avail-left { display: flex; flex-direction: column; gap: 4px; }
.avail-title {
  font: 600 .82rem/1 'DM Sans',sans-serif; color: var(--ink);
}
.avail-sub { font-size: .72rem; color: var(--ink-dim); }
.toggle-wrap { display: flex; align-items: center; gap: 12px; }
.toggle-label { font-size: .72rem; color: var(--ink-dim); }
.toggle {
  width: 48px; height: 26px; border-radius: 999px;
  background: var(--surface-3); border: 1px solid var(--line);
  position: relative; cursor: pointer; transition: background .25s, border-color .25s;
  flex-shrink: 0; outline: none;
}
.toggle::after {
  content: ''; position: absolute; top: 3px; left: 3px;
  width: 18px; height: 18px; border-radius: 50%;
  background: var(--ink-dim); transition: transform .25s, background .25s;
}
.toggle.on { background: rgba(111,186,138,.2); border-color: rgba(111,186,138,.4); }
.toggle.on::after { transform: translateX(22px); background: var(--ok); }
.specialty-chips-edit {
  display: flex; gap: 7px; flex-wrap: wrap; margin-top: 12px; width: 100%;
}
.chip-add-btn {
  padding: 5px 12px; border-radius: 999px;
  background: none; border: 1px dashed rgba(200,160,80,.3);
  font: 600 .59rem/1 'DM Sans',sans-serif;
  letter-spacing: .1em; text-transform: uppercase;
  color: var(--gold-dk); cursor: pointer; transition: all .2s;
}
.chip-add-btn:hover { border-color: var(--gold); color: var(--gold); background: rgba(200,160,80,.08); }
.chip-removable {
  display: flex; align-items: center; gap: 5px;
}
.chip-x {
  font-size: .7rem; color: var(--ink-dim); cursor: pointer;
  transition: color .15s; line-height: 1;
}
.chip-x:hover { color: #e07070; }

/* ══ DIVIDER ══════════════════════════════════════════════ */
.divider {
  display: flex; align-items: center; gap: 14px;
  max-width: 860px; margin: 36px auto 20px;
  padding: 0 clamp(16px,4vw,36px);
}
.divider-line { flex: 1; height: 1px; background: linear-gradient(90deg,transparent,var(--line),transparent); }
.divider-text {
  font: 700 .57rem/1 'DM Sans',sans-serif;
  letter-spacing: .22em; text-transform: uppercase;
  color: var(--gold); opacity: .55; white-space: nowrap;
}
.divider-gem { font-size: .5rem; color: var(--gold); opacity: .4; }

/* ══ POSTS GRID ═══════════════════════════════════════════ */
.posts-wrap {
  max-width: 860px; margin: 0 auto 40px;
  padding: 0 clamp(16px,4vw,36px);
}
.posts-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 10px;
}
@media(max-width:560px) { .posts-grid { grid-template-columns: repeat(2,1fr); gap: 8px; } }
.post-card {
  position: relative; border-radius: 12px; overflow: hidden;
  background: var(--surface); border: 1px solid var(--line-soft);
  aspect-ratio: 1/1; cursor: pointer;
  transition: transform .25s var(--ease), border-color .2s;
}
.post-card:hover { transform: translateY(-3px); border-color: rgba(200,160,80,.28); }
.post-card img {
  width: 100%; height: 100%; object-fit: cover; display: block;
  transition: transform .4s var(--ease);
}
.post-card:hover img { transform: scale(1.04); }
.post-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(13,10,7,.82) 0%, transparent 55%);
  display: flex; flex-direction: column;
  justify-content: flex-end; padding: 12px;
  opacity: 0; transition: opacity .2s;
}
.post-card:hover .post-overlay { opacity: 1; }
.post-occasion {
  font: 700 .55rem/1 'DM Sans',sans-serif;
  letter-spacing: .16em; text-transform: uppercase;
  color: var(--gold); margin-bottom: 4px;
}
.post-caption {
  font-family: 'Cormorant Garamond',serif;
  font-size: .85rem; color: rgba(250,246,240,.85); line-height: 1.35;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.post-hearts {
  position: absolute; top: 10px; right: 10px;
  display: flex; align-items: center; gap: 4px;
  background: rgba(13,10,7,.6); backdrop-filter: blur(6px);
  padding: 4px 8px; border-radius: 999px;
  font: 600 .65rem/1 'DM Sans',sans-serif; color: rgba(250,246,240,.8);
}
.post-placeholder {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-family: 'Pinyon Script',cursive; font-size: 2.5rem;
  color: var(--gold); opacity: .18;
  flex-direction: column; gap: 8px;
}
.post-placeholder-label {
  font-family: 'DM Sans',sans-serif; font-family: 'DM Sans',sans-serif;
  font-size: .6rem; letter-spacing: .14em; text-transform: uppercase;
  color: var(--ink-dim); font-style: normal;
}
.post-delete {
  position: absolute; top: 8px; right: 8px;
  width: 26px; height: 26px; border-radius: 50%;
  background: rgba(13,10,7,.75); backdrop-filter: blur(6px);
  border: 1px solid rgba(255,255,255,.15);
  color: rgba(250,246,240,.7); font-size: .65rem;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; opacity: 0; transition: opacity .2s, background .2s;
  z-index: 10;
}
.post-card:hover .post-delete { opacity: 1; }
.post-delete:hover { background: rgba(180,60,60,.8); color: #fff; border-color: transparent; }
@media(hover:none){ .post-delete { opacity: 1; } }

/* Video in post card */
.post-card video {
  width: 100%; height: 100%; object-fit: cover; display: block;
}
.post-video-badge {
  position: absolute; top: 10px; left: 10px;
  background: rgba(13,10,7,.65); backdrop-filter: blur(6px);
  padding: 3px 8px; border-radius: 999px;
  font: 700 .55rem/1 'DM Sans',sans-serif;
  letter-spacing: .1em; color: rgba(250,246,240,.8);
}
/* On touch devices always show overlay */
@media (hover: none) {
  .post-overlay { opacity: 1; background: linear-gradient(to top, rgba(13,10,7,.72) 0%, transparent 50%); }
}

/* ══ BOARDS GRID ══════════════════════════════════════════ */
.templates-wrap { max-width: 860px; margin: 0 auto 40px; padding: 0 clamp(16px,4vw,36px); }
.templates-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px,1fr)); gap: 14px; }
