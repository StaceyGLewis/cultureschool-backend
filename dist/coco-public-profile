        <div class="avail-left">
          <div class="avail-title">Available for projects</div>
          <div class="avail-sub">When on, your profile shows as open and you appear in creator search.</div>
        </div>
        <div class="toggle-wrap">
          <span class="toggle-label">${isOpen?'Open':'Closed'}</span>
          <button class="toggle ${isOpen?'on':''}" id="availToggle" onclick="toggleAvailability()" aria-pressed="${isOpen}"></button>
        </div>
        <div class="specialty-chips-edit" id="specialtyChipsEdit">
          ${chips.map(a=>`
            <span class="chip chip-removable">
              ${esc(a)}
              <span class="chip-x" onclick="removeSpecialty('${esc(a)}')" title="Remove">✕</span>
