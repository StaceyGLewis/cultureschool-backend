function renderAvailPanel(c){
  if(!isOwnProfile) return;
  const isOpen = !!c.available_for_hire;
  const chips  = (c.available_for||[]);
  document.getElementById('availMount').innerHTML = `
    <div class="avail-panel anim anim-3">
