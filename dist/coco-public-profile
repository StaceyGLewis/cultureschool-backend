    showToast('Add a photo or caption first'); return;
  }

  postBtn.textContent = 'Posting…';
  postBtn.disabled    = true;

  let imageUrl = null;
  try {
    if(selectedFile){
      imageUrl = await uploadToStorage(selectedFile);
    } else if(urlInput){
      imageUrl = urlInput;
    }
  } catch(err){
    console.error(err);
    showToast('Upload failed — try again');
    postBtn.textContent = 'Post →'; postBtn.disabled = false; return;
  }

  const { error } = await db.from('creator_posts').insert([{
    creator_email: signedInEmail,
    image_url:     imageUrl || null,
    caption:       caption  || null,
    occasion:      postOccasion || null,
    palette_code:  paletteCode || null,
  }]);

  postBtn.textContent = 'Post →'; postBtn.disabled = false;

  if(error){ showToast('Couldn\'t post — try again'); console.error(error); return; }

  // ── Also post to Daily Inspo feed (inspo_wall) ──────────────────
  const creatorName = CREATOR?.display_name || CREATOR?.username ||
                      signedInEmail.split('@')[0];
  const specialties = (CREATOR?.available_for || []).join(', ');
  const tagStr = [
    postOccasion,
    paletteCode,
    'made with coco',
    specialties,
  ].filter(Boolean).join(',').toLowerCase();

  await db.from('inspo_wall').insert([{
    title:       postOccasion || 'A moment',
    caption:     caption || null,
    image:       imageUrl || null,
    email:       signedInEmail,
    source_url:  `${location.origin}${location.pathname}?email=${encodeURIComponent(signedInEmail)}`,
    is_public:   true,
    publicwall:  true,
    type:        postOccasion || 'Community',
    tags:        tagStr || 'community,made with coco',
    featured_at: new Date().toISOString(),
  }]);

  // Reset modal
  closeModal('shareModal');
  selectedFile = null;
  document.getElementById('postCaption').value    = '';
  document.getElementById('postPaletteCode').value = '';
  document.getElementById('postImageUrl').value    = '';
  document.getElementById('postImageUrl').style.display = 'none';
  document.getElementById('urlToggle').textContent = 'Or paste a URL instead';
  document.getElementById('uploadPreview').style.display = 'none';
  document.getElementById('uploadZoneInner').style.display = 'flex';
  document.getElementById('uploadZone').classList.remove('has-file');
  document.getElementById('postFileInput').value = '';
  document.querySelectorAll('#occasionPills .occasion-pill').forEach(b=>b.classList.remove('sel'));
  postOccasion = '';

  showToast('Moment shared ✦', true);
  await renderPosts(signedInEmail);
  await renderStats(signedInEmail);
}

