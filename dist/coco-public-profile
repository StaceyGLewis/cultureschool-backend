async function toggleAvailability(){
  const btn    = document.getElementById('availToggle');
  const isOpen = btn.classList.contains('on');
  const newVal = !isOpen;
  btn.classList.toggle('on', newVal);
  btn.setAttribute('aria-pressed', newVal);
  btn.previousElementSibling.textContent = newVal ? 'Open' : 'Closed';
  CREATOR.available_for_hire = newVal;
  await db.from('creators').update({ available_for_hire: newVal }).eq('email', CREATOR.email);
  // Refresh hero badge
  const badge = document.querySelector('.avail-badge');
  if(badge){
    badge.className = 'avail-badge ' + (newVal?'avail-badge-open':'avail-badge-closed');
    badge.innerHTML = `<span class="avail-dot"></span> ${newVal?'Open for projects':'Not taking projects'}`;
  }
  showToast(newVal ? 'You\'re open for projects ✦' : 'Availability turned off', newVal);
}

async function toggleSpecialty(val){
  const chips = CREATOR.available_for || [];
  const idx   = chips.indexOf(val);
  if(idx > -1) chips.splice(idx,1); else chips.push(val);
  CREATOR.available_for = chips;
  await db.from('creators').update({ available_for: chips }).eq('email', CREATOR.email);
  renderChipsEdit();
}
async function removeSpecialty(val){ await toggleSpecialty(val); }
function renderChipsEdit(){
  const el = document.getElementById('specialtyChipsEdit');
  if(!el) return;
  const chips = CREATOR.available_for || [];
  el.innerHTML = chips.map(a=>`
    <span class="chip chip-removable">
      ${esc(a)}
      <span class="chip-x" onclick="removeSpecialty('${esc(a)}')" title="Remove">✕</span>
    </span>`).join('') +
    `<button class="chip-add-btn" onclick="openModal('specialtyModal')">+ Add specialty</button>`;
  // Also update hero chips
  const heroChips = document.querySelector('.hero-chips');
  if(heroChips) heroChips.innerHTML = chips.map(a=>`<span class="chip">${esc(a)}</span>`).join('');
}

