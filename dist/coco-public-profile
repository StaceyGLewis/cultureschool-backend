/* ══════════════════════════════════════════════════════
   UTILS
══════════════════════════════════════════════════════ */
function esc(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function hideLoader(){
  const l = document.getElementById('loader');
  if(!l) return;
  l.classList.add('fade');
  setTimeout(()=>{ if(l) l.style.display='none'; }, 450);
}

// Safety net — always show something after 6s even if Supabase hangs
const _loaderTimeout = setTimeout(()=>{
  const l = document.getElementById('loader');
  if(l && l.style.display !== 'none' && !l.classList.contains('fade')){
    hideLoader();
    document.getElementById('heroMount').innerHTML = `
      <div style="text-align:center;padding:80px 20px">
        <p style="font-family:'Cormorant Garamond',serif;font-style:italic;color:var(--ink-dim);font-size:1.05rem;line-height:1.7">
          Taking too long to load.<br>
          ${location.protocol === 'file:' ? 'Local file preview has limits — <strong style="color:var(--gold-dk)">deploy to Netlify to test fully</strong>.' : 'Check your connection and try again.'}
        </p>
        <button class="hero-btn hero-btn-ghost" style="margin-top:20px" onclick="location.reload()">Reload</button>
      </div>`;
  }
}, 6000);

// Global error fallback — script error never leaves loader spinning
window.addEventListener('error', ()=> hideLoader());
window.addEventListener('unhandledrejection', ()=> hideLoader());
function showToast(msg,ok){ const t=document.getElementById('toast'); t.textContent=msg; t.className='toast show'+(ok?' ok':''); clearTimeout(t._t); t._t=setTimeout(()=>t.className='toast',2800); }
function openModal(id){ document.getElementById(id).classList.add('open'); }
function closeModal(id,e){ if(!e||!document.querySelector('#'+id+' .modal').contains(e.target)) document.getElementById(id).classList.remove('open'); }

