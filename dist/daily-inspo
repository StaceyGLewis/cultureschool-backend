        URL.revokeObjectURL(url);
        if (typeof showToast === 'function') showToast(_frameEmbedded ? '✦ Downloaded — add to your story' : 'Downloaded your photo — the frame couldn’t be embedded on this device.');
      } catch(err) {
        console.error('[frame download]', err);
        if (typeof showToast === 'function') showToast('Could not render — try again');
      } finally {
        btn.textContent = '↓ Download';
        btn.disabled = false;
      }
    };

    /* Save & Share */
    g('#__fcSave').onclick = async function() {
      const btn = this;
      btn.textContent = 'Saving…';
      btn.disabled = true;
      try {
        const blob = await _renderToCanvas();
        if (!blob) throw new Error('render failed');

        // Upload to Supabase storage
        const fname = 'frame-' + Date.now() + '-' + Math.random().toString(36).slice(2,6) + '.png';
        const res = await fetch(`${SUPA_URL}/storage/v1/object/coco-drops/${fname}`, {
          method:  'POST',
          headers: {
            'apikey':        SUPA_ANON,
            'Authorization': `Bearer ${SUPA_ANON}`,
            'Content-Type':  'image/png',
            'x-upsert':      'true',
          },
          body: blob,
        });
        if (!res.ok) throw new Error('upload failed');
        const publicUrl = `${SUPA_URL}/storage/v1/object/public/coco-drops/${fname}`;

        // Save to inspo_wall
        const email = (window.__userEmail || localStorage.getItem('userEmail') || 'anonymous@coco').toLowerCase();
        const title = _mode === 'text' ? (_text.slice(0,80) || 'A framed vision') : `${_frame.label} · Vision Board`;
        const db = window.db || (window.supabase && window.supabase.createClient(SUPA_URL, SUPA_ANON));
        if (db) {
          await db.from('inspo_wall').insert([{
            title,
            image:       publicUrl,
            caption:     'Made with Frame Your Vision · CoCo Daily Inspo',
            email,
            is_public:   true,
            publicwall:  true,
            type:        'Frame Your Vision',
            tags:        'frame,vision board,made with coco',
            featured_at: new Date().toISOString(),
          }]);
        }

        closeComposer();
        if (!_frameEmbedded && typeof showToast === 'function')
          showToast('Saved your photo — the frame couldn’t be embedded on this device.');
        if (typeof showCelebration === 'function') showCelebration(title, null);
        if (typeof loadItems === 'function') await loadItems();

      } catch(err) {
        console.error('[frame save]', err);
        if (typeof showToast === 'function') showToast('Could not save — please try again');
      } finally {
        btn.textContent = '✦ Save & Share';
        btn.disabled = false;
      }
    };
  }

  /* ── Handle photo file ── */
  async function _handlePhotoFile(file, scrim) {
    const g = id => scrim.querySelector(id);
    const reader = new FileReader();
    reader.onload = function(e) {
      _photoDataUrl = e.target.result;
      _photoBlob    = file;
      g('#__fcDropInner').style.display    = 'none';
      g('#__fcPhotoPreview').style.display = 'block';
      g('#__fcPreviewImg').src = _photoDataUrl;
      _refreshPreview(scrim);
    };
    reader.readAsDataURL(file);
  }

  /* ── Refresh live preview ── */
  function _refreshPreview(scrim) {
    const g = id => scrim.querySelector(id);
    const fill     = g('#__fcFill');
    const textLayer= g('#__fcTextLayer');
    const bounds   = getFrameBounds(_frame);

    const topPct    = (bounds.top  * 100) + '%';
    const leftPct   = (bounds.left * 100) + '%';
    const rightPct  = (bounds.right * 100) + '%';
    const bottomPct = (bounds.bottom * 100) + '%';
    const insetStyle = `top:${topPct};left:${leftPct};right:${rightPct};bottom:${bottomPct};`;

    if (_mode === 'photo' && _photoDataUrl) {
      fill.style.cssText = `position:absolute;${insetStyle}z-index:1;display:flex;align-items:center;justify-content:center;border-radius:2px;overflow:hidden;`;
      fill.innerHTML = `<img src="${_photoDataUrl}" style="width:100%;height:100%;object-fit:cover;display:block;">`;
      textLayer.style.display = 'none';
    } else if (_mode === 'text' && _text) {
      fill.style.display = 'none';
      const fontStyle  = _font === 'Cinzel' ? 'normal' : 'italic';
      const fontWeight = _font === 'Cinzel' ? '500' : '300';
      textLayer.style.cssText = `position:absolute;${insetStyle}z-index:1;display:flex;align-items:center;justify-content:center;text-align:center;padding:12px;`;
      textLayer.innerHTML = `<div style="
        font-family:'${_font}',serif;
        font-style:${fontStyle};
        font-weight:${fontWeight};
        font-size:${Math.max(14, Math.round(_fontSize * 0.38))}px;
        color:#3a2800;
        line-height:1.4;
        word-break:break-word;
        text-shadow:0 1px 4px rgba(255,255,255,.6);
      ">${escHtml(_text)}</div>`;
    } else {
      fill.style.display      = 'none';
      textLayer.style.display = 'none';
    }
  }

  /* ── Canvas render ── */
  async function _renderToCanvas() {
    const isLandscape = _frame.orientation === 'landscape';
    const W = isLandscape ? 1600 : 1200;
    const H = isLandscape ? 1200 : 1600;

    const canvas = document.createElement('canvas');
    canvas.width = W; canvas.height = H;
    const ctx = canvas.getContext('2d');

    // White base
    ctx.fillStyle = '#faf6f0';
    ctx.fillRect(0, 0, W, H);

    // Fill (photo or text) — drawn BEHIND frame
    const bounds = getFrameBounds(_frame);
    const fx = Math.round(bounds.left  * W);
    const fy = Math.round(bounds.top   * H);
    const fw = Math.round((1 - bounds.left - bounds.right)  * W);
    const fh = Math.round((1 - bounds.top  - bounds.bottom) * H);

    if (_mode === 'photo' && _photoDataUrl) {
      const photoImg = await _loadImg(_photoDataUrl);
      // Cover-fit into fill area
      const scale = Math.max(fw / photoImg.width, fh / photoImg.height);
      const pw = photoImg.width * scale, ph = photoImg.height * scale;
      ctx.save();
      ctx.beginPath();
      ctx.rect(fx, fy, fw, fh);
      ctx.clip();
      ctx.drawImage(photoImg, fx + (fw - pw) / 2, fy + (fh - ph) / 2, pw, ph);
      ctx.restore();
    } else if (_mode === 'text' && _text) {
      ctx.save();
      ctx.beginPath(); ctx.rect(fx, fy, fw, fh); ctx.clip();
      // Subtle parchment tint
      ctx.fillStyle = 'rgba(245,236,220,.45)';
      ctx.fillRect(fx, fy, fw, fh);
      ctx.restore();
      // Text
      ctx.save();
      ctx.beginPath(); ctx.rect(fx, fy, fw, fh); ctx.clip();
      ctx.textAlign = 'center';
      const fontStyle  = _font === 'Cinzel' ? '' : 'italic ';
      ctx.font = `${fontStyle}${_fontSize}px '${_font}', serif`;
      ctx.fillStyle = '#3a2800';
      ctx.shadowColor = 'rgba(255,255,255,.6)';
      ctx.shadowBlur  = 8;
      const cx = fx + fw / 2;
      const words = _text.split(' ');
      const lines  = [];
      let   line   = '';
      for (const w of words) {
        const test = line ? line + ' ' + w : w;
        if (ctx.measureText(test).width > fw - 40) { if (line) lines.push(line); line = w; }
        else line = test;
      }
      if (line) lines.push(line);
      const lh = _fontSize * 1.4;
      let y = fy + fh / 2 - (lines.length * lh) / 2 + _fontSize * 0.8;
      lines.forEach(function(l) { ctx.fillText(l, cx, y); y += lh; });
      ctx.restore();
    }

    // Frame image — drawn ON TOP with multiply so the cream background drops out.
    // If it can't load CORS-clean, SKIP it rather than taint the canvas (a tainted
    // canvas makes toBlob return null and the whole save fail silently).
    _frameEmbedded = true;
    try {
      const frameImg = await _loadImg(_frame.url + '?_cb=' + Date.now());
      ctx.globalCompositeOperation = 'multiply';
      ctx.drawImage(frameImg, 0, 0, W, H);
      ctx.globalCompositeOperation = 'source-over';
    } catch (e) {
      console.warn('[frame] frame image not CORS-clean; exporting without it:', e);
      _frameEmbedded = false;
    }

    return new Promise(function(resolve, reject) {
      try {
        canvas.toBlob(function(b){ b ? resolve(b) : reject(new Error('toBlob returned null')); }, 'image/png');
      } catch (e) { reject(e); }
    });
  }

  function _loadImg(src) {
    return new Promise(function(resolve, reject) {
      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.onload  = function() { resolve(img); };
      img.onerror = function() {
        // DON'T retry without crossOrigin — that loads the image but taints
        // the canvas, so toBlob() returns null and the save dies silently.
        // Instead fetch it as a CORS blob → object URL, which stays clean.
        fetch(src, { mode: 'cors', cache: 'reload' })
          .then(function(r) { if (!r.ok) throw new Error('fetch ' + r.status); return r.blob(); })
          .then(function(b) {
            const u  = URL.createObjectURL(b);
            const im = new Image();
            im.onload  = function() { resolve(im); };
            im.onerror = function() { URL.revokeObjectURL(u); reject(new Error('blob-img failed')); };
            im.src = u;
          })
          .catch(reject);
      };
      img.src = src;
    });
  }

  function escHtml(s) {
    return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

})();

