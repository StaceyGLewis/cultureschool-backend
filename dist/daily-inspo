let _activeFilterIdx = 0;

function setPreviewRatio(ratio, btn) {
  // File upload preview
  const img = document.getElementById('__mDropImg');
  if (img) img.style.aspectRatio = ratio;

  // URL paste preview — uses padding-bottom trick for background-image divs
  const prevImg = document.getElementById('__mPreviewImg');
  if (prevImg) {
    const padMap = { '1/1':'100%', '4/5':'125%', '16/9':'56.25%' };
    prevImg.style.paddingBottom = padMap[ratio] || '125%';
    prevImg.style.height = '0';
    prevImg.style.backgroundSize = 'cover';
    prevImg.style.backgroundPosition = 'center';
  }

  // Update button states
  document.querySelectorAll('.ratio-btn').forEach(b => {
    const active = b === btn;
    b.style.borderColor = active ? 'rgba(200,160,80,.5)'  : 'rgba(255,255,255,.12)';
    b.style.background  = active ? 'rgba(200,160,80,.12)' : 'rgba(255,255,255,.05)';
    b.style.color       = active ? 'var(--gold,#c8a050)'  : 'var(--muted)';
  });
}

window.setPreviewRatio = setPreviewRatio;

function buildFilterStrip(imgSrc) {
  const scroll = document.getElementById('__mFilterScroll');
  const strip  = document.getElementById('__mFilterStrip');
  if (!scroll || !imgSrc || /\.(mp4|webm|mov|ogg)/i.test(imgSrc)) {
    if (strip) strip.classList.remove('visible');
    return;
  }
  _activeFilterIdx = 0;
  scroll.innerHTML = COCO_FILTERS.map((f, i) => `
    <div class="filter-item${i === 0 ? ' active' : ''}" data-fi="${i}" onclick="selectFilter(${i})">
      <div class="filter-item-thumb">
        <img src="${imgSrc.replace(/"/g,'&quot;')}" style="filter:${f.css};" alt="${f.name}">
      </div>
      <span class="filter-item-name">${f.name}</span>
    </div>`).join('');
  strip.classList.add('visible');
}

function selectFilter(idx) {
  _activeFilterIdx = idx;
  const filter = COCO_FILTERS[idx];

  // Apply to file upload preview
  const dropImg = document.getElementById('__mDropImg');
  if (dropImg) dropImg.style.filter = filter.css === 'none' ? '' : filter.css;

  // Apply to URL paste preview
  const prevImg = document.getElementById('__mPreviewImg');
  if (prevImg) prevImg.style.filter = filter.css === 'none' ? '' : filter.css;

  // Update active state in strip
  document.querySelectorAll('.filter-item').forEach((el, i) => {
    el.classList.toggle('active', i === idx);
  });
}

window.selectFilter = selectFilter;

