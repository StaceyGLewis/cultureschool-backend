async function runMatch(queryColors) {
  document.getElementById('lookupResults').style.display = 'none';
  document.getElementById('lookupLoading').style.display = 'block';
  const palettes = await fetchAllPalettes();
  if (!palettes.length) {
    document.getElementById('lookupLoading').textContent = 'Could not load palettes — try again.';
    return;
  }
  const scored = palettes
    .filter(p => p.colors && p.colors.length)
    .map(p => ({ ...p, score: paletteDistance(queryColors, p.colors) }))
    .sort((a,b) => a.score - b.score);
  renderLookupResults(scored, queryColors);
}

function matchHex() {
  const raw = document.getElementById('hexInput').value.trim();
  const hex = raw.startsWith('#') ? raw : '#' + raw;
  if (!/^#[0-9a-fA-F]{6}$/.test(hex)) {
    alert('Please enter a valid hex code like #c9a96e');
    return;
  }
  runMatch([hex]);
}

function extractFromPhoto(input) {
  const file = input.files[0];
  if (!file) return;
  document.getElementById('uploadLabel').textContent = file.name;
  const img = new Image();
  const url = URL.createObjectURL(file);
  img.onload = function() {
    const canvas = document.getElementById('extractCanvas');
    const SIZE = 100; // sample at 100x100 for speed
    canvas.width = SIZE; canvas.height = SIZE;
    const ctx = canvas.getContext('2d');
    ctx.drawImage(img, 0, 0, SIZE, SIZE);
    URL.revokeObjectURL(url);

    // Sample pixels and quantize to dominant colors
    const data = ctx.getImageData(0, 0, SIZE, SIZE).data;
    const buckets = {};
    for (let i = 0; i < data.length; i += 4) {
      const r = Math.round(data[i]   / 32) * 32;
      const g = Math.round(data[i+1] / 32) * 32;
      const b = Math.round(data[i+2] / 32) * 32;
      if (data[i+3] < 128) continue; // skip transparent
      const key = `${r},${g},${b}`;
      buckets[key] = (buckets[key] || 0) + 1;
    }
    const sorted = Object.entries(buckets).sort((a,b) => b[1]-a[1]).slice(0,5);
    const extracted = sorted.map(([key]) => {
      const [r,g,b] = key.split(',').map(Number);
      return '#' + [r,g,b].map(v => Math.min(255,v).toString(16).padStart(2,'0')).join('');
    });

    // Show swatches — tall chips with hex + xkcd name, click to run single-color match
    const swatchEl = document.getElementById('extractedSwatches');
    swatchEl.innerHTML = extracted.map(c => {
      const xkcd = nearestXkcd(c);
      const nameRow = xkcd
        ? `<div style="padding:4px 4px 5px;background:rgba(0,0,0,.5);text-align:center;
            font:500 .48rem/1.3 var(--sans,sans-serif);color:rgba(255,255,255,.75);
            letter-spacing:.02em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${xkcd.name}</div>`
        : '';
      return `<div onclick="window._extractedColors=['${c}'];runMatch(['${c}'])"
        title="${c}" style="
        cursor:pointer;border-radius:10px;overflow:hidden;
        box-shadow:0 3px 10px rgba(0,0,0,.4);transition:transform .15s;flex:1;min-width:52px;"
        onmouseover="this.style.transform='translateY(-2px)'"
        onmouseout="this.style.transform=''">
        <div style="height:60px;background:${c};"></div>
        <div style="padding:5px 4px;background:rgba(0,0,0,.35);text-align:center;
          font:700 .52rem/1 monospace;color:#fff;letter-spacing:.04em;">${c}</div>
        ${nameRow}
      </div>`;
    }).join('');
    document.getElementById('extractedColors').style.display = 'block';
    window._extractedColors = extracted;
  };
  img.src = url;
}

function matchExtracted() {
  if (window._extractedColors && window._extractedColors.length) {
    runMatch(window._extractedColors);
  }
}

