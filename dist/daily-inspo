let _pwaPrompt = null;
window.addEventListener('beforeinstallprompt', e => {
  e.preventDefault();
  _pwaPrompt = e;
  const visits = parseInt(localStorage.getItem('coco_visits') || '0') + 1;
  localStorage.setItem('coco_visits', visits);
  if (visits >= 2 && !localStorage.getItem('coco_pwa_dismissed')) {
    const banner = document.getElementById('pwaInstallBanner');
    if (banner) banner.style.display = 'flex';
  }
});

function triggerPWAInstall() {
  if (_pwaPrompt) {
    _pwaPrompt.prompt();
    _pwaPrompt.userChoice.then(r => {
      if (r.outcome === 'accepted') localStorage.setItem('coco_pwa_dismissed','1');
      document.getElementById('pwaInstallBanner').style.display = 'none';
    });
  } else {
    // iOS fallback
    alert('To add CoCo to your home screen: tap the Share button, then "Add to Home Screen"');
    dismissPWABanner();
  }
}

function dismissPWABanner() {
  localStorage.setItem('coco_pwa_dismissed','1');
  document.getElementById('pwaInstallBanner').style.display = 'none';
}

// iOS: show banner after 2 visits even without beforeinstallprompt
(function() {
  const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);
  const isStandalone = window.navigator.standalone;
  if (isIOS && !isStandalone) {
    const visits = parseInt(localStorage.getItem('coco_visits') || '0') + 1;
    localStorage.setItem('coco_visits', visits);
    if (visits >= 2 && !localStorage.getItem('coco_pwa_dismissed')) {
      const btn = document.getElementById('pwaInstallBtn');
      if (btn) {
        btn.textContent = 'How to Install';
        btn.onclick = function() {
          alert('Tap the Share button ↑ at the bottom of Safari, then tap "Add to Home Screen"');
          dismissPWABanner();
        };
      }
      const banner = document.getElementById('pwaInstallBanner');
      if (banner) banner.style.display = 'flex';
    }
  }
})();

