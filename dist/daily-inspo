  // bakeFilter — applies CSS color grade + physical film effects to canvas
  // grain: noise, vignette: dark edges, wash: color overlay, fade: lifted shadows
  function bakeFilter(file, filterDef, maxDim, quality) {
    return new Promise((resolve) => {
      const img = new Image();
      const url = URL.createObjectURL(file);
      img.onload = () => {
        URL.revokeObjectURL(url);
        const scale = Math.min(1, maxDim / Math.max(img.width, img.height));
        const W = Math.round(img.width  * scale);
        const H = Math.round(img.height * scale);
        const canvas = document.createElement('canvas');
        canvas.width = W; canvas.height = H;
        const ctx = canvas.getContext('2d');

        // 1. Color grade via CSS filter (hue, saturation, sepia, contrast)
        if (filterDef.css && filterDef.css !== 'none') ctx.filter = filterDef.css;
        ctx.drawImage(img, 0, 0, W, H);
        ctx.filter = 'none';

        // 2. Film grain — pixel-level luminance noise
        if (filterDef.grain > 0) {
          const imgData = ctx.getImageData(0, 0, W, H);
          const d = imgData.data;
          const g = filterDef.grain * 255;
          for (let i = 0; i < d.length; i += 4) {
            const n = (Math.random() - 0.5) * g;
            d[i]   = Math.max(0, Math.min(255, d[i]   + n));
            d[i+1] = Math.max(0, Math.min(255, d[i+1] + n));
            d[i+2] = Math.max(0, Math.min(255, d[i+2] + n));
          }
          ctx.putImageData(imgData, 0, 0);
        }

        // 3. Vignette — radial dark gradient from edges inward
        if (filterDef.vignette > 0) {
          const grad = ctx.createRadialGradient(
            W/2, H/2, Math.min(W,H)*0.28,
            W/2, H/2, Math.max(W,H)*0.78
          );
          grad.addColorStop(0, 'rgba(0,0,0,0)');
          grad.addColorStop(1, 'rgba(0,0,0,' + filterDef.vignette + ')');
          ctx.fillStyle = grad;
          ctx.fillRect(0, 0, W, H);
        }

        // 4. Color wash — tonal bias overlay (warmth, coolness, haze)
        if (filterDef.wash) {
          ctx.fillStyle = filterDef.wash;
          ctx.fillRect(0, 0, W, H);
        }

        // 5. Fade — lifted shadows like aged or expired film
        if (filterDef.fade > 0) {
          ctx.fillStyle = 'rgba(255,250,245,' + filterDef.fade + ')';
          ctx.fillRect(0, 0, W, H);
        }

        canvas.toBlob(blob => resolve(blob || file), 'image/jpeg', quality);
      };
      img.onerror = () => resolve(file);
      img.src = url;
    });
  }

