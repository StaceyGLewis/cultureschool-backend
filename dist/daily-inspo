function setGallerySpan(card) {
  const media = card.querySelector('.gallery-img') || card.querySelector('video');

  const applySpan = () => {
    const h = card.getBoundingClientRect().height;
    if (h > 10) card.style.gridRow = 'span ' + Math.ceil((h + 14) / 1);
  };

  // Double RAF: first ensures paint, second ensures grid reflow
  const doSpan = () => {
    requestAnimationFrame(() => requestAnimationFrame(applySpan));
  };

  // Also re-check after 400ms — catches Safari mobile layout delays
  const doSpanWithFallback = () => {
    doSpan();
    setTimeout(() => requestAnimationFrame(applySpan), 400);
  };

  if (!media) { doSpanWithFallback(); return; }

  if (media.tagName === 'VIDEO') {
    media.style.minHeight = '200px';
    if (media.readyState >= 1) {
      doSpanWithFallback();
    } else {
      media.addEventListener('loadedmetadata', doSpanWithFallback, { once: true });
      media.addEventListener('error', () => { card.style.gridRow = 'span 300'; }, { once: true });
      setTimeout(doSpanWithFallback, 800);
    }
  } else {
    // Check complete immediately — handles cached images that won't fire load
    if (media.complete && media.naturalHeight) {
      doSpanWithFallback();
    } else {
      media.addEventListener('load',  doSpanWithFallback, { once: true });
      media.addEventListener('error', doSpanWithFallback, { once: true });
      // Fallback for Safari where load sometimes doesn't fire on cached images
      setTimeout(doSpanWithFallback, 600);
    }
  }
}

