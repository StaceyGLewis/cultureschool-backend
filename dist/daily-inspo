<style>
/* ═══════════════════════════════════════════
   THE DAILY INSPO — CultureSchool
   Warm editorial gallery. Domestika meets
   Pinterest but every card is a moment someone
   made for someone they love.
═══════════════════════════════════════════ */

:root {
  --bg:       #faf6f0;
  --surface:  #ffffff;
  --ink:      #1e1810;
  --ink-soft: #5a4a38;
  --muted:    #9a8a78;
  --line:     #e8ddd0;
  --gold:     #c8a050;
  --gold-lt:  #e8d4a0;
  --gold-dk:  #8a6820;
  --script:   'Pinyon Script', cursive;
  --serif:    'DM Serif Display', Georgia, serif;
  --sans:     'DM Sans', system-ui, sans-serif;
  --ease:     cubic-bezier(.22,.61,.36,1);
  --radius:   16px;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; overflow-x: hidden; }

body {
  font-family: var(--sans);
  background: var(--bg);
  color: var(--ink);
  min-height: 100vh;
  overflow-x: hidden;
  max-width: 100%;
}

/* Grain */
@keyframes popupIn {
  from { opacity: 0; transform: translateX(-50%) translateY(12px); }
  to   { opacity: 1; transform: translateX(-50%) translateY(0); }
}

body::before {
  content: '';
  position: fixed; inset: 0; z-index: 9999;
  pointer-events: none; opacity: .022;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-size: 256px;
}

/* ── TOPBAR ── */
.topbar {
  position: sticky; top: 0; z-index: 100;
  background: rgba(250,246,240,.94);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--line);
  padding: 0 clamp(16px,4vw,40px);
  height: 58px;
  display: flex; align-items: center; justify-content: space-between; gap: 16px;
}

.topbar-logo {
  display: flex; align-items: center; gap: 8px;
  font-family: var(--script);
  font-size: 1.8rem;
  font-weight: 400;
  color: var(--ink);
  text-decoration: none;
  letter-spacing: .02em;
  line-height: 1;
  flex-shrink: 0;
}
.topbar-logo img { width: 30px; height: 30px; object-fit: contain; flex-shrink: 0; }

.topbar-nav {
  display: flex; gap: 20px; align-items: center;
  font-size: .72rem; font-weight: 600;
  letter-spacing: .1em; text-transform: uppercase;
}
.topbar-nav a {
  color: var(--muted); text-decoration: none;
  transition: color .2s;
}
.topbar-nav a:hover, .topbar-nav a.active { color: var(--gold-dk); }

.topbar-search {
  display: flex; align-items: center; gap: 8px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 7px 14px;
  max-width: 280px; flex: 1;
}
.topbar-search input {
  border: none; outline: none; background: none;
  font: 500 .82rem/1 var(--sans);
  color: var(--ink); width: 100%;
}
.topbar-search input::placeholder { color: var(--muted); }

.topbar-right { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }

.btn-share {
  display: flex; align-items: center; gap: 6px;
  padding: 8px 18px;
  background: var(--gold);
  color: #fff; border: none; border-radius: 999px;
  font: 700 .68rem/1 var(--sans);
  letter-spacing: .12em; text-transform: uppercase;
  cursor: pointer;
  box-shadow: 0 3px 12px rgba(200,160,80,.3);
  transition: all .25s var(--ease);
  white-space: nowrap;
}
.btn-share:hover { background: var(--gold-dk); transform: translateY(-1px); box-shadow: 0 6px 18px rgba(200,160,80,.4); }
.btn-share.hidden { display: none; }

.btn-signin {
  padding: 8px 16px;
  border: 1px solid var(--line);
  background: var(--surface); color: var(--ink-soft);
  border-radius: 999px;
  font: 600 .68rem/1 var(--sans);
  letter-spacing: .08em; text-transform: uppercase;
  cursor: pointer; transition: all .2s;
  white-space: nowrap;
}
.btn-signin:hover { border-color: var(--gold); color: var(--gold-dk); }
.btn-signin.hidden { display: none; }

/* ── HERO ── */
/* ── FILTER BAR ── */
.filter-bar {
  display: flex; gap: 8px; align-items: center;
  padding: 16px clamp(16px,4vw,40px);
  overflow-x: auto; -webkit-overflow-scrolling: touch;
  border-bottom: 1px solid var(--line);
}
.filter-bar::-webkit-scrollbar { display: none; }
.filter-chip {
  padding: 6px 16px;
  border-radius: 999px;
  border: 1px solid var(--line);
  background: var(--surface);
  font: 600 .7rem/1 var(--sans);
  letter-spacing: .08em; text-transform: uppercase;
  color: var(--ink-soft); cursor: pointer;
  white-space: nowrap; flex-shrink: 0;
  transition: all .2s;
}
.filter-chip:hover, .filter-chip.active {
  background: var(--ink); color: #fff; border-color: var(--ink);
}
.cat-pick {
  padding: 7px 14px;
  border-radius: 999px;
  border: 1px solid var(--line);
  background: var(--surface);
  font: 600 .68rem/1 var(--sans);
  letter-spacing: .06em; text-transform: uppercase;
  color: var(--ink-soft); cursor: pointer;
  transition: all .18s;
}
.cat-pick:hover { border-color: var(--gold); color: var(--gold-dk); }
.cat-pick.sel {
  background: var(--gold); color: #fff; border-color: var(--gold);
}

/* ── GALLERY GRID ── */
.gallery-wrap {
  max-width: 1400px; margin: 0 auto;
  padding: 12px clamp(4px,1vw,10px) 40px;
}

/* ── LISTING CARDS — editorial, visual-feed worthy ── */
.listing-card {
  grid-row: span 260;
  border-radius: 14px;
  overflow: hidden;
  cursor: pointer;
  position: relative;
  transition: transform .22s var(--ease), box-shadow .22s var(--ease);
  border: none;
}
.listing-card:hover { transform: translateY(-3px); box-shadow: 0 12px 36px rgba(0,0,0,.4); }

/* Full bleed gradient hero — different per type */
.listing-card.type-looking_for {
  background: linear-gradient(160deg, #1a0a0a 0%, #2a1010 40%, #0e0b07 100%);
  box-shadow: inset 0 0 60px rgba(178,34,52,.08);
}
.listing-card.type-available {
  background: linear-gradient(160deg, #071a0f 0%, #0d2a18 40%, #070e0b 100%);
  box-shadow: inset 0 0 60px rgba(0,107,60,.08);
}

/* Decorative large letter watermark */
.listing-card::before {
  content: attr(data-glyph);
  position: absolute; right: -10px; top: -16px;
  font: 700 7rem/1 var(--serif);
  opacity: .04; pointer-events: none; user-select: none;
  color: #fff; line-height: 1;
}

/* Accent bar — left side */
.listing-card::after {
  content: '';
  position: absolute; left: 0; top: 0; bottom: 0;
  width: 3px;
}
.listing-card.type-looking_for::after { background: linear-gradient(180deg,#b22234,#7a1520); }
.listing-card.type-available::after   { background: linear-gradient(180deg,#006b3c,#004d2b); }

.listing-inner { padding: 18px 16px 14px 20px; position: relative; }

.listing-type-pill {
  display: inline-flex; align-items: center; gap: 5px;
  font: 700 .52rem/1 var(--sans);
  letter-spacing: .18em; text-transform: uppercase;
  padding: 4px 10px; border-radius: 100px;
  margin-bottom: 12px;
}
.type-looking_for .listing-type-pill {
  background: rgba(178,34,52,.2); color: #e08080;
  border: 1px solid rgba(178,34,52,.3);
}
.type-available .listing-type-pill {
  background: rgba(0,107,60,.2); color: #5cc690;
  border: 1px solid rgba(0,107,60,.3);
}

.listing-title {
  font: 400 italic clamp(1rem,2.8vw,1.2rem)/1.3 var(--serif);
  color: #faf6f0; margin-bottom: 8px; letter-spacing: -.01em;
}

.listing-desc {
  font: 300 .73rem/1.65 var(--sans);
  color: rgba(245,235,210,.45);
  display: -webkit-box; -webkit-line-clamp: 2;
  -webkit-box-orient: vertical; overflow: hidden;
  margin-bottom: 12px;
}

.listing-tags {
  display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 14px;
}
.listing-tag {
  font: 600 .5rem/1 var(--sans);
  letter-spacing: .1em; text-transform: uppercase;
  padding: 3px 8px; border-radius: 100px;
}
.type-looking_for .listing-tag {
  background: rgba(178,34,52,.12); color: rgba(224,128,128,.8);
  border: 1px solid rgba(178,34,52,.18);
}
.type-available .listing-tag {
  background: rgba(0,107,60,.15); color: rgba(92,198,144,.8);
  border: 1px solid rgba(0,107,60,.22);
}

.listing-footer {
  display: flex; align-items: center; justify-content: space-between;
  gap: 8px; padding: 10px 16px 12px 20px;
  border-top: 1px solid rgba(255,255,255,.05);
}
.listing-expiry {
  font: 500 .58rem/1 var(--sans);
  color: rgba(200,160,80,.4); letter-spacing: .05em;
}
.listing-poster-info {
  font: 400 .62rem/1 var(--sans);
  color: rgba(245,235,210,.35);
}
.listing-respond-btn {
  padding: 7px 16px; border-radius: 100px; border: none;
  font: 700 .6rem/1 var(--sans);
  letter-spacing: .08em; text-transform: uppercase;
  cursor: pointer; transition: all .2s; white-space: nowrap;
  flex-shrink: 0;
}
.type-looking_for .listing-respond-btn {
  background: rgba(178,34,52,.2); color: #e08080;
  border: 1px solid rgba(178,34,52,.35);
}
.type-looking_for .listing-respond-btn:hover {
  background: rgba(178,34,52,.35); color: #f0a0a0;
}
.type-available .listing-respond-btn {
  background: rgba(0,107,60,.2); color: #5cc690;
  border: 1px solid rgba(0,107,60,.38);
}
.type-available .listing-respond-btn:hover {
  background: rgba(0,107,60,.35); color: #7de0b0;
}
.listing-respond-btn.responded {
  background: rgba(0,107,60,.15); border-color: rgba(0,107,60,.3);
  color: #5cc690; cursor: default;
}
.listing-poster-dot {
  width: 22px; height: 22px; border-radius: 50%;
  font: 700 .58rem/1 var(--sans);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.type-looking_for .listing-poster-dot {
  background: rgba(178,34,52,.2); color: #e08080;
  border: 1px solid rgba(178,34,52,.25);
}
.type-available .listing-poster-dot {
  background: rgba(0,107,60,.2); color: #5cc690;
  border: 1px solid rgba(0,107,60,.25);
}
.listing-poster { display:flex; align-items:center; gap:7px; margin-bottom:12px; }

/* ── GALLERY — Pinterest content-first ── */
.gallery {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  grid-auto-rows: 1px;
  column-gap: 6px;
  padding: 0;
  align-items: start;
}
@media (max-width: 900px) { .gallery { grid-template-columns: repeat(3,1fr); column-gap: 5px; } }
@media (max-width: 560px) { .gallery { grid-template-columns: repeat(2,1fr); column-gap: 4px; } }

.gallery-item {
  grid-row: span 320;   /* generous default — doSpan corrects after load */
  margin-bottom: 6px;
  border-radius: 14px;
  overflow: hidden;
  background: var(--surface);
  border: none;
  box-shadow: 0 1px 3px rgba(0,0,0,.07);
  transition: transform .22s var(--ease), box-shadow .22s var(--ease);
  cursor: pointer;
  position: relative;
}
.gallery-item:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(40,28,12,.13);
}

@keyframes cardIn {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: translateY(0); }
}

.gallery-img {
  width: 100%; display: block;
  height: auto; object-fit: cover;
  border-radius: 14px 14px 0 0;
  transition: transform .3s var(--ease);
}
.gallery-item:hover .gallery-img { transform: scale(1.025); }

/* Video cards */
.gallery-item video.gallery-img { transform: none !important; }
.gallery-item:has(video)::before {
  content: '▶';
  position: absolute; top: 8px; left: 8px; z-index: 2;
  background: rgba(0,0,0,.45); color: #fff;
  font-size: .55rem; padding: 3px 7px;
  border-radius: 999px;
  pointer-events: none;
  backdrop-filter: blur(4px);
}

.gallery-body {
  padding: 8px 10px 10px;
  display: flex; flex-direction: column; gap: 4px;
}

.card-heart-display {
  display: flex; align-items: center; gap: 4px;
  padding: 0 0 1px;
  font: 600 .7rem/1 var(--sans);
  color: rgba(214,120,120,.75);
  letter-spacing: .02em;
}

.gallery-badge { display: none; } /* badge lives in modal only */

.gallery-title {
  font-family: var(--sans);
  font-size: .82rem;
  font-weight: 600; line-height: 1.3; letter-spacing: -.01em;
  color: var(--ink); margin-bottom: 4px;
}

/* ── MORE MENU (global popover — never clipped by cards) ── */
.more-menu {
  position: fixed;
  z-index: 12000;
  min-width: 190px;
  background: var(--surface, #fff);
  border: 1px solid rgba(200,160,80,.25);
  border-radius: 14px;
  box-shadow: 0 12px 40px rgba(40,28,12,.22), 0 2px 8px rgba(40,28,12,.1);
  padding: 6px;
  display: none;
}
.more-menu.show { display: block; animation: menuIn .15s var(--ease); }
@keyframes menuIn {
  from { opacity: 0; transform: translateY(4px) scale(.98); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
.more-item {
  display: flex; align-items: center; gap: 10px;
  width: 100%;
  padding: 10px 12px;
  border-radius: 9px;
  background: none; border: none;
  font: 500 .82rem/1 var(--sans, sans-serif);
  color: var(--ink);
  cursor: pointer;
  text-align: left;
  -webkit-tap-highlight-color: transparent;
  text-decoration: none;
}
.more-item:hover, .more-item:active { background: rgba(200,160,80,.1); color: var(--gold-dk); }
.more-item svg { flex-shrink: 0; }

.gallery-creator {
  display: flex; align-items: center; gap: 7px;
  font-size: .85rem; font-weight: 500; color: var(--ink-soft);
}

.gallery-creator-dot {
  width: 24px; height: 24px; border-radius: 50%;
  background: linear-gradient(135deg, var(--gold-dk), var(--gold));
  display: flex; align-items: center; justify-content: center;
  font-size: .7rem; font-weight: 800; color: #fff;
  flex-shrink: 0;
}

/* .gallery-actions moved to modal */

.action-btn {
  display: flex; align-items: center; justify-content: center;
  background: none; border: none;
  color: var(--muted);
  cursor: pointer;
  width: 34px; height: 34px;
  border-radius: 8px;
  transition: all .2s;
  -webkit-tap-highlight-color: transparent;
  flex-shrink: 0;
}
.action-btn:hover { color: var(--gold-dk); background: rgba(200,160,80,.08); }
.action-btn:active { color: var(--gold); transform: scale(.92); }
.action-btn:disabled { opacity: .5; cursor: not-allowed; }
.collect-btn:hover { color: var(--gold-dk); }
.clap-btn.clapped  { color: #e05a5a; }
.heart-count {
  font: 600 .68rem/1 'DM Sans', sans-serif;
  margin-left: 3px;
  min-width: 10px;
  color: inherit;
  opacity: .85;
}
.heart-count:empty { display: none; }
.palette-btn { color: #7c5cbf !important; }
.palette-btn:hover { color: #6a3fbf !important; background: rgba(162,120,230,.08) !important; }

.palette-strip {
  display: none; /* shown in modal via detail overlay */
  width: 100%;
  padding: 7px 14px;
  background: rgba(162,120,230,.07);
  border: none;
  border-top: 1px solid rgba(162,120,230,.12);
  border-bottom: 1px solid rgba(162,120,230,.12);
  color: #7c5cbf;
  font: 600 .8rem/1 var(--sans);
  letter-spacing: .08em;
  text-transform: uppercase;
  cursor: pointer;
  text-align: left;
  transition: background .18s ease, color .18s ease;
}
.palette-strip:hover {
  background: rgba(162,120,230,.14);
  color: #5a3fa0;
}

.gallery-link {
  display: block;
  margin: 0 14px 12px;
  padding: 8px 14px;
  background: linear-gradient(135deg, rgba(200,160,80,.08), rgba(200,160,80,.04));
  border: 1px solid rgba(200,160,80,.2);
  border-radius: 8px;
  font: 600 .65rem/1 var(--sans);
  letter-spacing: .06em; text-transform: uppercase;
  color: var(--gold-dk); text-decoration: none;
  text-align: center;
  transition: all .2s;
}
.gallery-link:hover { background: var(--gold); color: #fff; border-color: var(--gold); }

/* ── EMPTY STATE ── */
.empty-state {
  grid-column: 1 / -1;
  text-align: center;
  padding: 80px 20px;
}
.empty-state-icon {
  font-family: var(--script);
  font-size: 3rem; color: var(--gold);
  margin-bottom: 12px;
}
.empty-state p {
  font-family: var(--serif); font-style: italic;
  font-size: 1.1rem; color: var(--ink-soft);
}

/* ── SKELETON ── */
.skel-item {
  break-inside: avoid; margin-bottom: 16px;
  border-radius: var(--radius); overflow: hidden;
  background: var(--surface); border: 1px solid var(--line);
}
.skel-img {
  width: 100%; background: #f0ebe3;
  animation: shimmer 1.4s ease-in-out infinite;
}
.skel-body { padding: 12px 14px; }
.skel-line {
  height: 10px; border-radius: 4px;
  background: #f0ebe3;
  animation: shimmer 1.4s ease-in-out infinite;
  margin-bottom: 8px;
}
.skel-line.short { width: 60%; }
@keyframes shimmer {
  0%,100% { opacity: .5; }
  50%      { opacity: 1; }
}

/* ── CULTURAL FILTERS ── */
.filter-strip-wrap {
  margin-top: 10px; display: none;
}
.filter-strip-wrap.visible { display: block; }
.filter-strip-label {
  font: 700 .55rem/1 var(--sans);
  letter-spacing: .18em; text-transform: uppercase;
  color: rgba(200,160,80,.55);
  margin-bottom: 8px;
}
.filter-strip-scroll {
  display: flex; gap: 8px;
  overflow-x: auto; padding-bottom: 6px;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}
.filter-strip-scroll::-webkit-scrollbar { display: none; }
.filter-item {
  display: flex; flex-direction: column; align-items: center;
  gap: 5px; flex-shrink: 0; cursor: pointer;
}
.filter-item-thumb {
  width: 52px; height: 52px; border-radius: 8px;
  overflow: hidden; border: 2px solid transparent;
  transition: border-color .15s;
  flex-shrink: 0;
}
.filter-item-thumb img {
  width: 100%; height: 100%;
  object-fit: cover; display: block;
}
.filter-item.active .filter-item-thumb {
  border-color: var(--gold, #c8a050);
  box-shadow: 0 0 0 1px var(--gold, #c8a050);
}
.filter-item-name {
  font: 600 .5rem/1.2 var(--sans);
  letter-spacing: .04em; text-align: center;
  color: var(--muted); max-width: 60px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  transition: color .15s;
}
.filter-item.active .filter-item-name { color: var(--gold, #c8a050); }

/* ── SHARE MODAL ── */
.pattern-share-banner {
  position: fixed; top: 0; left: 0; right: 0; z-index: 800;
  background: linear-gradient(135deg, var(--gold-dk, #8a6020), var(--gold, #c9a96e));
  color: #1e1610;
  display: flex; align-items: center; gap: 12px;
  padding: 12px 16px 12px 20px;
  box-shadow: 0 4px 20px rgba(0,0,0,.2);
  animation: slideDown .4s cubic-bezier(.22,1,.36,1) both;
  flex-wrap: wrap;
}
@keyframes slideDown { from{transform:translateY(-100%)} to{transform:translateY(0)} }
.pattern-share-banner-info { flex: 1; min-width: 0; }
.pattern-share-banner-eyebrow {
  font: 700 .52rem/1 var(--sans, "DM Sans", sans-serif);
  letter-spacing: .2em; text-transform: uppercase;
  opacity: .7; margin-bottom: 3px;
}
.pattern-share-banner-title {
  font: 600 .88rem/1.2 var(--serif, "Cormorant Garamond", serif);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.pattern-share-banner-origin {
  font: 400 .7rem/1.3 var(--sans, "DM Sans", sans-serif);
  opacity: .75; margin-top: 2px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.pattern-share-banner-swatch {
  display: flex; height: 28px; border-radius: 6px; overflow: hidden;
  flex-shrink: 0; width: 100px;
  box-shadow: 0 2px 8px rgba(0,0,0,.2);
}
.pattern-share-banner-swatch i { flex: 1; display: block; }
.pattern-share-banner-cta {
  flex-shrink: 0; padding: 9px 18px; border-radius: 999px;
  background: rgba(30,22,16,.85); color: #f0e0c0;
  font: 700 .62rem/1 var(--sans, "DM Sans", sans-serif);
  letter-spacing: .1em; text-transform: uppercase;
  border: none; cursor: pointer; transition: background .18s;
  white-space: nowrap;
}
.pattern-share-banner-cta:hover { background: rgba(30,22,16,1); }
.pattern-share-banner-dismiss {
  flex-shrink: 0; width: 24px; height: 24px; border-radius: 50%;
  background: rgba(30,22,16,.2); border: none; cursor: pointer;
  color: #1e1610; font-size: .8rem; display: flex;
  align-items: center; justify-content: center; transition: background .18s;
}
.pattern-share-banner-dismiss:hover { background: rgba(30,22,16,.4); }

.modal-scrim {
  position: fixed; inset: 0; z-index: 10000;
  background: rgba(30,24,16,.65);
  backdrop-filter: blur(8px);
  display: flex; align-items: center; justify-content: center;
  padding: 20px;
  opacity: 0; animation: scrimIn .25s var(--ease) forwards;
}
@keyframes scrimIn { to { opacity: 1; } }

.modal-box {
  width: min(520px, 100%);
  max-height: 90vh;
  overflow-y: auto;
  background: var(--bg);
  border-radius: 24px;
  padding: 32px 28px 24px;
  box-shadow: 0 24px 80px rgba(0,0,0,.3);
  position: relative;
  transform: translateY(20px);
  animation: modalIn .3s .05s var(--ease) forwards;
}
@keyframes modalIn { to { transform: translateY(0); } }

.modal-close {
  position: absolute; top: 16px; right: 18px;
  background: none; border: none;
  font-size: 1.1rem; color: var(--muted);
  cursor: pointer; line-height: 1;
  transition: color .2s;
}
.modal-close:hover { color: var(--ink); }

.modal-title {
  font-family: var(--script);
  font-size: 2.4rem; font-weight: 400; line-height: 1;
  color: var(--ink); margin-bottom: 6px;
}
.modal-sub {
  font-family: var(--serif); font-style: italic;
  font-size: .9rem; color: var(--ink-soft);
  margin-bottom: 24px; line-height: 1.5;
}

.modal-field {
  display: flex; flex-direction: column; gap: 6px;
  margin-bottom: 14px;
}
.modal-label {
  font: 700 .65rem/1 var(--sans);
  letter-spacing: .15em; text-transform: uppercase;
  color: var(--muted);
}
.modal-input {
  padding: 11px 14px;
  border: 1px solid var(--line);
  border-radius: 10px;
  font: 500 .9rem/1 var(--sans);
  color: var(--ink); background: var(--surface);
  outline: none;
  transition: border-color .2s;
}
.modal-input:focus { border-color: var(--gold); }
.modal-input::placeholder { color: var(--muted); }

.modal-footer {
  display: flex; align-items: center; justify-content: flex-end;
  gap: 10px; margin-top: 20px;
}
.modal-status {
  flex: 1; font: 400 .8rem/1 var(--sans);
  color: var(--muted); font-style: italic;
}
.modal-cancel {
  padding: 10px 18px;
  border: 1px solid var(--line); border-radius: 999px;
  background: var(--surface); color: var(--ink-soft);
  font: 600 .68rem/1 var(--sans);
  letter-spacing: .1em; text-transform: uppercase;
  cursor: pointer; transition: all .2s;
}
.modal-cancel:hover { border-color: var(--ink); color: var(--ink); }

.modal-submit {
  padding: 11px 24px;
  border: none; border-radius: 999px;
  background: linear-gradient(135deg, var(--gold-dk), var(--gold));
  color: #fff;
  font: 700 .68rem/1 var(--sans);
  letter-spacing: .12em; text-transform: uppercase;
  cursor: pointer;
  box-shadow: 0 4px 16px rgba(200,160,80,.3);
  transition: all .25s var(--ease);
}
.modal-submit:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(200,160,80,.4); }
.modal-submit:disabled { opacity: .5; cursor: not-allowed; transform: none; }

/* ── SIGN IN PROMPT ── */
.signin-prompt {
  background: linear-gradient(135deg, rgba(200,160,80,.06), rgba(200,160,80,.02));
  border: 1px solid rgba(200,160,80,.18);
  border-radius: 12px;
  padding: 16px 20px;
  text-align: center;
  margin: 0 14px 12px;
  display: none;
}
.signin-prompt p {
  font-family: var(--serif); font-style: italic;
  font-size: .88rem; color: var(--ink-soft); margin-bottom: 10px;
}
.signin-prompt-btn {
  padding: 8px 20px;
  background: var(--gold); color: #fff; border: none;
  border-radius: 999px;
  font: 700 .65rem/1 var(--sans);
  letter-spacing: .1em; text-transform: uppercase;
  cursor: pointer; transition: all .2s;
}
.signin-prompt-btn:hover { background: var(--gold-dk); }

/* ── CARD SHARE ── */
.share-btn {
  margin-left: auto;
}
.share-btn:hover { color: var(--gold-dk); background: rgba(200,160,80,.08); }
/* ── STORY BUTTON ── */
.story-btn {
  color: var(--gold-dk);
  font-weight: 700;
  border-color: rgba(200,160,80,.3);
}
.story-btn:hover { background: rgba(200,160,80,.1); color: var(--gold); }
.story-btn:disabled { opacity: .5; cursor: wait; }


/* ── CELEBRATION SHARE PANEL ── */
.celebrate-scrim {
  position: fixed; inset: 0; z-index: 20000;
  background: rgba(30,24,16,.75);
  backdrop-filter: blur(10px);
  display: flex; align-items: center; justify-content: center;
  padding: 20px;
  animation: scrimIn .25s var(--ease) forwards;
}
.celebrate-box {
  width: min(480px, 100%);
  background: linear-gradient(160deg, #0d0a07 0%, #181410 100%);
  border-radius: 24px;
  padding: 36px 28px 28px;
  text-align: center;
  position: relative;
  box-shadow: 0 24px 80px rgba(0,0,0,.5), 0 0 0 1px rgba(200,160,80,.15);
  animation: modalIn .35s .05s var(--ease) forwards;
  transform: translateY(20px);
}
.celebrate-title {
  font-family: var(--script);
  font-size: 2.8rem; font-weight: 400; line-height: 1;
  color: #faf6f0; margin-bottom: 8px;
  text-shadow: 0 2px 30px rgba(200,160,80,.3);
}
.celebrate-sub {
  font-family: var(--serif); font-style: italic;
  font-size: .95rem; color: rgba(232,212,160,.75);
  margin-bottom: 28px; line-height: 1.5;
}
.celebrate-btns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px; margin-bottom: 16px;
}
.celebrate-btn {
  display: flex; align-items: center; justify-content: center; gap: 8px;
  padding: 13px 16px;
  border-radius: 12px; border: 1px solid rgba(255,255,255,.1);
  background: rgba(255,255,255,.05);
  color: #faf6f0;
  font: 600 .72rem/1 var(--sans);
  letter-spacing: .08em; text-transform: uppercase;
  cursor: pointer; text-decoration: none;
  transition: all .2s var(--ease);
}
.celebrate-btn:hover {
  background: rgba(200,160,80,.15);
  border-color: rgba(200,160,80,.4);
  transform: translateY(-1px);
}
.celebrate-btn.copy-btn.copied {
  color: var(--gold);
  border-color: var(--gold);
}
.celebrate-btn-full {
  grid-column: 1 / -1;
  background: linear-gradient(135deg, var(--gold-dk), var(--gold));
  border-color: transparent;
  color: #1e1810;
}
.celebrate-btn-full:hover {
  filter: brightness(1.1);
  border-color: transparent;
}
.celebrate-skip {
  font: 400 .72rem/1 var(--sans);
  color: rgba(255,255,255,.3);
  background: none; border: none;
  cursor: pointer; padding: 8px;
  transition: color .2s;
}
.celebrate-skip:hover { color: rgba(255,255,255,.6); }

/* Confetti dots */
.confetti-dot {
  position: absolute;
  width: 6px; height: 6px;
  border-radius: 50%;
  pointer-events: none;
  animation: confettiFall linear forwards;
}
@keyframes confettiFall {
  0%   { transform: translateY(0) rotate(0deg); opacity: 1; }
  100% { transform: translateY(80px) rotate(360deg); opacity: 0; }
}

/* ── TOAST ── */
.toast {
  position: fixed; bottom: 30px; left: 50%;
  transform: translateX(-50%) translateY(20px);
  background: var(--ink); color: #faf6f0;
  font: 600 .78rem/1 var(--sans);
  letter-spacing: .06em;
  padding: 12px 22px; border-radius: 999px;
  box-shadow: 0 8px 28px rgba(0,0,0,.25);
  z-index: 20000; pointer-events: none;
  opacity: 0; transition: all .3s var(--ease);
}
.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
.toast.action { pointer-events: auto; cursor: pointer; }
.toast a {
  color: var(--gold, #c8a050);
  text-decoration: underline;
  text-underline-offset: 3px;
  margin-left: 6px;
}

/* ── MOBILE ── */
@media (max-width: 640px) {
  .topbar-nav { display: none; }
  .topbar-search { max-width: 160px; }
  .filter-bar { padding: 12px 12px; }
  .gallery-wrap { padding: 8px 4px 32px; }
  .gallery { columns: 2 150px; column-gap: 10px; }
  .gallery-item { margin-bottom: 10px; border-radius: 16px; }
  .gallery-img { min-height: 140px; }

  /* ── Make With CoCo — horizontal scroll on mobile ── */
  .frame-row {
    display: flex !important;
    grid-template-columns: none !important;
    flex-wrap: nowrap !important;
    overflow-x: auto !important; overflow-y: hidden !important;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: 10px; padding-bottom: 4px;
    max-height: none !important;
    width: 100%; min-width: 0;
  }
  .frame-row::-webkit-scrollbar { display: none; }
  .frame-row .frame-thumb {
    flex: 0 0 130px; scroll-snap-align: start;
  }
  .frame-row .frame-thumb:nth-child(1),
  .frame-row .frame-thumb:nth-child(2) { flex: 0 0 150px; }

  /* Collapse via display so horizontal row hides cleanly */
  .frame-row.collapsed {
    display: none !important;
    max-height: 0; opacity: 0; margin-bottom: 0;
  }

  /* Template picker — horizontal scroll too */
  #__mTemplatePicker {
    flex-wrap: nowrap !important;
    overflow-x: auto; scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch; scrollbar-width: none;
    justify-content: flex-start !important;
  }
  #__mTemplatePicker::-webkit-scrollbar { display: none; }
  #__mTemplatePicker .__mTplBtn {
    flex: 0 0 120px !important; width: 120px !important;
    scroll-snap-align: start;
  }
}

/* ── MOBILE FEED — single column, immersive ── */
@media (max-width: 480px) {

  /* Filter bar — horizontal scroll */
  .filter-bar {
    padding: 10px 0;
    -webkit-overflow-scrolling: touch;
  }
  .filter-chip {
    font-size: .6rem;
    padding: 6px 14px;
    flex-shrink: 0;
  }

  /* Gallery — 2-column Pinterest layout, immersive */
  .gallery {
    columns: 2 !important;
    column-gap: 10px !important;
  }

  /* Gallery wrap */
  .gallery-wrap {
    padding: 12px 10px 80px;
  }

  /* Cards — rounded, deep shadow, no horizontal margin */
  .gallery-item {
    break-inside: avoid;
    margin-bottom: 10px;
    border-radius: 18px;
    margin-left: 0;
    margin-right: 0;
    border: none;
    box-shadow:
      0 4px 18px rgba(40,28,12,.1),
      0 0 0 1px rgba(200,160,80,.07);
  }

  /* Images — natural height, tall and immersive */
  .gallery-img {
    aspect-ratio: auto !important;
    width: 100%;
    object-fit: cover;
    object-position: center top;
    min-height: 210px;
    max-height: none;
  }

  /* Video cards */
  .gallery-item video.gallery-img {
    aspect-ratio: 4/3 !important;
  }

  /* Card body — compact on 2-col, images dominate */
  .gallery-body {
    padding: 8px 10px 8px;
  }
  .gallery-title {
    font-family: var(--sans);
    font-size: .92rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .gallery-creator {
    font-size: .76rem;
  }

  /* Actions — three primaries + ellipsis, generous tap targets */
  .gallery-actions {
    padding: 4px 8px 8px;
    gap: 0;
    justify-content: space-between;
    flex-wrap: nowrap;
  }
  .action-btn {
    padding: 10px 6px;
    font-size: .72rem;
  }

  /* Palette strip — tighter */
  .palette-strip {
    padding: 8px 12px;
    font-size: .72rem;
  }

  /* FAB */
  .fab-share {
    bottom: 16px; right: 16px;
    padding: 14px 22px;
    font-size: .8rem;
  }
}

/* ── GALLERY CAPTION ── */
.gallery-caption {
  padding: 10px 16px 4px;
  font-family: var(--sans);
  font-style: normal; font-weight: 400;
  font-size: clamp(.95rem,1.9vw,1.02rem);
  color: var(--ink-soft); line-height: 1.6;
}
/* ── 2-SLIDE CAROUSEL ── */
.slides-wrap { position:relative; overflow:hidden; }
.slides-inner {
  display:flex; overflow-x:auto;
  scroll-snap-type:x mandatory; scroll-behavior:smooth;
  -webkit-overflow-scrolling:touch; scrollbar-width:none;
}
.slides-inner::-webkit-scrollbar { display:none; }
.slide-item { flex:0 0 100%; scroll-snap-align:start; }
.slide-item img,.slide-item video { width:100%;display:block;object-fit:cover; }
.slide-dots {
  position:absolute; bottom:8px; left:50%;
  transform:translateX(-50%); display:flex; gap:5px;
  z-index:4; pointer-events:none;
}
.slide-dot { width:5px;height:5px;border-radius:50%;background:rgba(255,255,255,.4);transition:background .2s; }
.slide-dot.active { background:#fff; }
/* ── WEEKLY BRIEF ── */
.brief-card {
  border-radius: var(--radius); overflow: hidden;
  background: linear-gradient(135deg,#1e1608,#2a2010);
  border: 1px solid rgba(200,160,80,.35);
  box-shadow: 0 4px 24px rgba(40,28,12,.12);
  display: flex; align-items: stretch; margin-bottom: 8px;
}
.brief-accent { width:4px; flex-shrink:0; background:linear-gradient(to bottom,var(--gold-dk),var(--gold)); }
.brief-body { padding:18px 20px; flex:1; }
.brief-eyebrow { font:700 .58rem/1 var(--sans); letter-spacing:.28em; text-transform:uppercase; color:var(--gold); opacity:.85; margin-bottom:8px; }
.brief-title { font-family:var(--sans); font-size:clamp(1.05rem,2.5vw,1.25rem); font-weight:700; line-height:1.3; color:#faf6f0; margin-bottom:6px; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
.brief-caption { font-family:var(--sans); font-style:normal; font-weight:400; font-size:clamp(.9rem,2vw,1rem); color:rgba(250,246,240,.78); line-height:1.55; margin-bottom:10px; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
.brief-meta { font:600 .6rem/1 var(--sans); letter-spacing:.12em; text-transform:uppercase; color:var(--gold); opacity:.6; }
.brief-img { width:clamp(100px,25%,180px); object-fit:cover; display:block; flex-shrink:0; }
/* ── PROCESS CARDS ── */
.gallery-item.is-process {
  border-color: rgba(122,184,96,.2);
}
.gallery-item.is-process .gallery-badge {
  background: rgba(122,184,96,.12);
  color: #4a7a40;
}
.process-badge {
  position: absolute;
  top: 10px; left: 10px;
  background: rgba(90,138,80,.85);
  color: #fff;
  font: 700 .55rem/1 var(--sans);
  letter-spacing: .12em; text-transform: uppercase;
  padding: 4px 10px; border-radius: 999px;
  backdrop-filter: blur(4px);
}

/* ── CREATOR LINK ── */
.creator-link {
  color: inherit; text-decoration: none;
  border-bottom: 1px solid rgba(200,160,80,.25);
  transition: border-color .2s, color .2s;
}
.creator-link:hover { border-color: var(--gold-dk); color: var(--gold-dk); }

/* ── FRAME YOUR VISION ── */
.frame-section-head {
  display: flex; align-items: center; gap: 10px;
  margin-bottom: 12px;
  cursor: pointer; user-select: none;
}
.frame-section-eyebrow {
  font: 700 .6rem/1 var(--sans);
  letter-spacing: .2em; text-transform: uppercase;
  color: var(--gold-dk); opacity: .85;
}
.frame-section-chevron {
  font-size: .7rem; color: var(--gold-dk); opacity: .7;
  transition: transform .25s var(--ease); flex-shrink: 0;
}
.frame-section-head.collapsed .frame-section-chevron { transform: rotate(-90deg); }
.frame-row {
  display: grid; grid-template-columns: repeat(3,1fr); gap: 8px;
  margin-bottom: 18px;
  max-height: 600px; overflow: hidden;
  transition: max-height .3s var(--ease), opacity .25s var(--ease), margin .25s var(--ease);
}
.frame-row.collapsed {
  max-height: 0; opacity: 0; margin-bottom: 0;
}
.frame-thumb {
  border-radius: 8px; overflow: hidden;
  border: 2px solid var(--line);
  cursor: pointer;
  transition: border-color .2s, transform .2s, box-shadow .2s;
  background: #f4ede2;
  aspect-ratio: 3/4;
  position: relative;
}
.frame-thumb:nth-child(1), .frame-thumb:nth-child(2) { aspect-ratio: 4/3; }
.frame-thumb img {
  width: 100%; height: 100%; object-fit: cover; display: block;
  transition: transform .3s var(--ease);
}
.frame-thumb:hover { border-color: var(--gold); transform: translateY(-2px); box-shadow: 0 8px 20px rgba(200,160,80,.2); }
.frame-thumb:hover img { transform: scale(1.04); }
.frame-thumb.selected { border-color: var(--gold); box-shadow: 0 0 0 3px rgba(200,160,80,.25); }
.frame-thumb-label {
  position: absolute; bottom: 0; left: 0; right: 0;
  padding: 4px 6px;
  background: rgba(30,24,16,.65);
  font: 600 .5rem/1 var(--sans);
  letter-spacing: .08em; text-transform: uppercase;
  color: var(--gold-lt);
  text-align: center;
  backdrop-filter: blur(4px);
}

/* ── FRAME COMPOSER ── */
.frame-composer-scrim {
  position: fixed; inset: 0; z-index: 30000;
  background: rgba(20,14,6,.88);
  backdrop-filter: blur(14px);
  display: flex; align-items: center; justify-content: center;
  padding: 20px;
  animation: scrimIn .25s var(--ease) forwards;
}
.frame-composer-box {
  width: min(680px, 100%);
  max-height: 92vh;
  overflow-y: auto;
  background: var(--bg);
  border-radius: 20px;
  padding: 28px;
  box-shadow: 0 32px 80px rgba(0,0,0,.5);
  position: relative;
  transform: translateY(20px);
  animation: modalIn .3s .05s var(--ease) forwards;
}
.frame-composer-close {
  position: absolute; top: 14px; right: 16px;
  background: none; border: none; font-size: 1.1rem;
  color: var(--muted); cursor: pointer; transition: color .2s;
}
.frame-composer-close:hover { color: var(--ink); }
.frame-composer-title {
  font-family: var(--script);
  font-size: 1.9rem; font-weight: 400; line-height: 1;
  color: var(--ink); margin-bottom: 4px;
}
.frame-composer-sub {
  font-family: var(--serif); font-style: italic;
  font-size: .82rem; color: var(--ink-soft);
  margin-bottom: 18px; line-height: 1.5;
}
.frame-stage {
  position: relative;
  width: 100%;
  border-radius: 10px;
  overflow: hidden;
  background: #f4ede2;
  margin-bottom: 18px;
