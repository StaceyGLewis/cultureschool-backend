<script>
/* ══ COMMENTS ═══════════════════════════════════════════════
   Loads from inspo_comments table keyed by row_id.
   Renders below the main split — same position as YouTube
   comments below the video.
════════════════════════════════════════════════════════════ */
let _commentsRowId = null;

function timeAgoShort(ts) {
  const s = Math.floor((Date.now() - new Date(ts)) / 1000);
  if (s < 60) return 'just now';
  if (s < 3600) return Math.floor(s/60) + 'm ago';
  if (s < 86400) return Math.floor(s/3600) + 'h ago';
  if (s < 86400*7) return Math.floor(s/86400) + 'd ago';
  return new Date(ts).toLocaleDateString('en-US',{month:'short',day:'numeric'});
}

async function loadComments(rowId) {
  _commentsRowId = rowId;
  const section = document.getElementById('commentsSection');
  const list    = document.getElementById('commentsList');
  const count   = document.getElementById('commentsCount');
  if (!section || !rowId) return;

  section.style.display = 'block';
  list.innerHTML = '<div class="comment-empty">Loading…</div>';

  // Use the global esc — safe even if local closures haven't defined it yet
  const _esc = window.esc || (s => (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'));

  try {
    const url = window.SUPABASE_URL + '/rest/v1/inspo_comments'
      + '?select=id,row_id,author_name,author_email,body,board_url,created_at'
      + '&row_id=eq.' + encodeURIComponent(rowId)
      + '&order=created_at.asc&limit=50';
    const res = await fetch(url, {
      headers: { 'apikey': window.SUPABASE_KEY, 'Authorization': 'Bearer ' + window.SUPABASE_KEY }
    });
    if (!res.ok) {
      const errText = await res.text().catch(()=>'');
      console.warn('[comments] fetch failed', res.status, errText);
      list.innerHTML = '<div class="comment-empty">Could not load comments (' + res.status + ').</div>';
      return;
    }
    const comments = await res.json();

    count.textContent = comments.length;
    if (!comments.length) {
      list.innerHTML = '<div class="comment-empty">Be the first to share what this inspired.</div>';
      return;
    }
    list.innerHTML = comments.map(cm => {
      const initial = (cm.author_name || cm.author_email || '?').charAt(0).toUpperCase();
      const name    = cm.author_name
        || (cm.author_email || '').split('@')[0].replace(/[._-]+/g,' ').replace(/\b\w/g,x=>x.toUpperCase())
        || 'Community';
      return `
      <div class="comment-item">
        <div class="comment-avatar">${_esc(initial)}</div>
        <div class="comment-body">
          <div class="comment-author">${_esc(name)}</div>
          <div class="comment-text">${_esc(cm.body)}</div>
          ${cm.board_url ? `<a class="comment-board-link" href="${_esc(cm.board_url)}" target="_blank" rel="noopener">✦ View their board →</a>` : ''}
          <div class="comment-time">${timeAgoShort(cm.created_at)}</div>
        </div>
      </div>`;
    }).join('');
  } catch(e) {
    console.error('[comments] exception:', e);
    list.innerHTML = '<div class="comment-empty">Could not load comments.</div>';
  }
}

async function postComment() {
  const rowId    = _commentsRowId;
  const body     = (document.getElementById('commentBody')?.value || '').trim();
  const name     = (document.getElementById('commentName')?.value || '').trim();
  const boardUrl = (document.getElementById('commentBoardUrl')?.value || '').trim();
  // Resolve email the same way the rest of the app does
  const userEmail = (window.__userEmail || localStorage.getItem('userEmail') || localStorage.getItem('USER_EMAIL') || '').trim().toLowerCase();
  const btn      = document.getElementById('commentSubmitBtn');

  if (!body) { showToast('Write something first'); return; }
  if (!userEmail) {
    showToast('Sign in to post a comment');
    setTimeout(() => { if (typeof openSignIn === 'function') openSignIn(); }, 400);
    return;
  }

  btn.disabled = true; btn.textContent = 'Posting…';

  try {
    const res = await fetch(window.SUPABASE_URL + '/rest/v1/inspo_comments?apikey=' + window.SUPABASE_KEY, {
      method: 'POST',
      headers: {
        'apikey': window.SUPABASE_KEY,
        'Authorization': 'Bearer ' + window.SUPABASE_KEY,
        'Content-Type': 'application/json',
        'Prefer': 'return=minimal',
      },
      body: JSON.stringify({
        row_id:       rowId,
        author_email: userEmail.toLowerCase(),
        author_name:  name || null,
        body,
        board_url:    boardUrl || null,
      }),
    });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    document.getElementById('commentBody').value    = '';
    document.getElementById('commentBoardUrl').value = '';
    await loadComments(rowId);
    showToast('✦ Comment posted');
  } catch(e) {
    showToast('Could not post — try again');
  } finally {
    btn.disabled = false; btn.textContent = 'Post →';
  }
}

window.postComment = postComment;

/* ── Detail overlay state ── */
let _detailItems  = [];
let _detailIdx    = 0;

/* ── DYNAMIC CTA RESOLVER ──────────────────────────────────────
   Priority: creator-set label → inferred from URL → inferred from type
─────────────────────────────────────────────────────────────── */
function resolveCta(item) {
  const url = item.source_url || '';

  // Creator explicitly set a label — respect it verbatim
  if (item.cta_label) return { label: item.cta_label, url };

  // No URL → no CTA
  if (!url) return null;

  const u = url.toLowerCase();

  // Product / shop links
  if (u.includes('etsy.com') || u.includes('shopify') ||
      u.includes('/shop') || u.includes('/store') || u.includes('/buy') ||
      u.includes('/product') || u.includes('bigcartel') || u.includes('gumroad')) {
    return { label: 'Shop This →', url };
  }

  // Booking / service links
  if (u.includes('calendly') || u.includes('book') || u.includes('acuity') ||
      u.includes('square.site') || u.includes('dubsado')) {
    return { label: 'Book Me →', url };
  }

  // CoCo workspace / template links
  if (u.includes('flourish') || u.includes('cococreate') || u.includes('showcase')) {
    return { label: 'Make This →', url };
  }

  // Template / download
  if (u.includes('template') || u.includes('download') || u.includes('freebie')) {
    return { label: 'Download →', url };
  }

  // Instagram / portfolio
  if (u.includes('instagram.com') || u.includes('pinterest.com') || u.includes('behance')) {
    return { label: 'See More →', url };
  }

  // Generic fallback
  return { label: '→ Learn More', url };
}

function openDetail(item, allItems, idx) {
  _detailItems = allItems || [];
  _detailIdx   = idx ?? 0;
  _renderDetail(item);
  document.getElementById('inspoDetail').classList.add('open');
  document.body.style.overflow = 'hidden';
  document.getElementById('inspoDetail').scrollTop = 0;
}
window.openDetail = openDetail;

function closeDetail() {
  document.getElementById('inspoDetail').classList.remove('open');
  document.body.style.overflow = '';
  document.getElementById('commentsSection').style.display = 'none';
  document.getElementById('commentsList').innerHTML = '';
  _commentsRowId = null;
}
window.closeDetail = closeDetail;

function navigateDetail(dir) {
  const next = _detailIdx + dir;
  if (next < 0 || next >= _detailItems.length) return;
  _detailIdx = next;
  _renderDetail(_detailItems[_detailIdx]);
  document.getElementById('inspoDetail').scrollTop = 0;
}
window.navigateDetail = navigateDetail;

function _renderDetail(item) {
  const esc = s => (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');

  // Prev/next buttons
  document.getElementById('detailPrev').disabled = _detailIdx <= 0;
  document.getElementById('detailNext').disabled = _detailIdx >= _detailItems.length - 1;

  // Image
  const imgPanel = document.getElementById('detailImgPanel');
  const isVideo  = /\.(mp4|webm|ogg|mov)$/i.test(item.image||'');
  const isVideo2 = /\.(mp4|webm|ogg|mov)$/i.test(item.image_2||'');

  const makeMedia = (src, isVid, alt) => isVid
    ? `<video src="${esc(src)}" autoplay loop muted playsinline style="width:100%;height:100%;min-height:280px;object-fit:cover;display:block;"></video>`
    : `<img src="${esc(src)}" alt="${esc(alt||'')}" style="width:100%;height:100%;min-height:280px;object-fit:cover;display:block;">`;

  const _detailImgs = [item.image, item.image_2, item.image_3, item.image_4].filter(Boolean);
  if (_detailImgs.length > 1) {
    const _isVid = src => /\.(mp4|webm|ogg|mov)$/i.test(src||'');
    imgPanel.innerHTML = `
      <div class="slides-wrap" style="width:100%;height:100%;">
        <div class="slides-inner" id="slides-detail" style="height:100%;">${
          _detailImgs.map((s,i) => `<div class="slide-item">${makeMedia(s, _isVid(s), item.title+(i?' — '+(i+1):''))}</div>`).join('')
        }</div>
        <div class="slide-dots" style="position:absolute;bottom:12px;left:50%;transform:translateX(-50%);z-index:2;">${
          _detailImgs.map((_,i) => `<span class="slide-dot${i===0?' active':''}" id="dot-detail-${i}"></span>`).join('')
        }</div>
      </div>`;
    const inner = document.getElementById('slides-detail');
    const dots  = _detailImgs.map((_,i) => document.getElementById('dot-detail-'+i));
    if (inner && dots[0]) {
      const slides = inner.querySelectorAll('.slide-item');
      const obs = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          const idx = Array.from(slides).indexOf(entry.target);
          dots.forEach((d,i) => d && d.classList.toggle('active', i===idx));
        });
      }, { root: inner, threshold: 0.5 });
      slides.forEach(s => obs.observe(s));
    }
  } else if (item.image) {
    imgPanel.innerHTML = makeMedia(item.image, isVideo, item.title);
  } else {
    imgPanel.innerHTML = `<div style="width:100%;height:100%;min-height:300px;background:#111;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.2);font-size:2rem;">✦</div>`;
  }

  if (item.image && !isVideo) {
    const btn = document.createElement('button');
    btn.className = 'palette-extract-btn';
    btn.textContent = '◈ Color Lab';
    btn.setAttribute('data-image', item.image);
    btn.setAttribute('data-title', item.title||'');
    btn.className = 'palette-strip palette-extract-btn';
    imgPanel.appendChild(btn);
  }

  // Badge + title + caption
  document.getElementById('detailBadge').textContent   = item.type || 'Moment';
  document.getElementById('detailTitle').textContent   = item.title || 'Untitled Moment';
  document.getElementById('detailCaption').textContent = item.caption || '';
  document.getElementById('detailCaption').style.display = item.caption ? 'block' : 'none';

  // Creator
  const creatorName = item.email
    ? item.email.split('@')[0].replace(/[._-]+/g,' ').replace(/\b\w/g,c=>c.toUpperCase())
    : 'CoCo Community';
  const initials = (item.email||'C').charAt(0).toUpperCase();
  document.getElementById('detailCreator').innerHTML = `
    <div class="detail-creator-dot">${esc(initials)}</div>
    <div>
      <div class="detail-creator-name">${
        item.email
          ? `<a href="https://coco-public-profile.cultureschool.org/?email=${encodeURIComponent(item.email)}" target="_blank" rel="noopener">${esc(creatorName)}</a>`
          : esc(creatorName)
      }</div>
      <div class="detail-creator-time">${typeof getTimeAgo === 'function' ? getTimeAgo(item.featured_at) : ''}</div>
    </div>`;

  // Actions — all card buttons available in modal too
  const cta = resolveCta(item);
  document.getElementById('detailActions').innerHTML = `
    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;width:100%;">
      ${cta ? `<a class="detail-action primary" href="${esc(cta.url)}" target="_blank" rel="noopener" style="flex:1;min-width:120px;">${esc(cta.label)}</a>` : ''}
      <button class="detail-action secondary collect-btn"
        data-title="${esc(item.title||'')}"
        data-image="${esc(item.image||'')}"
        data-source="${esc(item.source_url||'')}"
        data-creator-email="${esc(item.email||'')}">◎ Collect</button>
      <button class="detail-action secondary clap-btn"
        data-row-id="${esc(item.row_id||'')}"
        data-image="${esc(item.image||'')}"
        data-source="${esc(item.source_url||'')}">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        <span class="heart-count" data-count-for="${esc(item.row_id||'')}"></span>
      </button>
      ${item.image && !isVideo ? `<a class="detail-action secondary"
        href="https://coco-color-lab.cultureschool.org/?img=${encodeURIComponent(item.image)}"
        target="_blank" rel="noopener"
        style="display:flex;align-items:center;gap:5px;white-space:nowrap;">
        ◈ Full Color Lab
      </a>` : ''}
      <button class="detail-action secondary nudge-btn"
        data-title="${esc(item.title||'')}"
        data-image="${esc(item.image||'')}"
        data-source="${esc(item.source_url||'https://coco-daily-inspo.cultureschool.org/')}"
        data-row-id="${esc(item.row_id||'')}">👋</button>
      <button class="detail-action secondary share-btn"
        data-title="${esc(item.title||'')}"
        data-source="${esc(item.source_url||'https://coco-daily-inspo.cultureschool.org/')}"
        data-row-id="${esc(item.row_id||'')}">↑ Share</button>
    </div>`;
  // Palette grab for images — shows in modal
  const paletteArea = document.getElementById('detailPaletteArea');
  if (paletteArea) {
    if (item.image && !isVideo) {
      paletteArea.innerHTML = `<button class="palette-strip" style="display:block;"
        data-image="${esc(item.image)}"
        data-title="${esc(item.title||'')}">◈ Color Lab</button>`;
    } else {
      paletteArea.innerHTML = '';
    }
  }

  // Load heart count for this item in modal
  if (item.row_id && typeof loadHearts === 'function') {
    loadHearts([item]);
  }

  // Load comments for this item
  if (item.row_id) {
    loadComments(item.row_id);
  } else {
    document.getElementById('commentsSection').style.display = 'none';
  }

  // Related — same tags or same creator, up to 6
  _renderRelated(item);
}

function _renderRelated(item) {
  const container = document.getElementById('detailRelated');
  if (!_detailItems.length) { container.innerHTML = ''; return; }

  const itemTags = Array.isArray(item.tags) ? item.tags : (item.tags||'').split(',').map(t=>t.trim().toLowerCase());

  const isVideoUrl = u => /\.(mp4|webm|mov|ogg)(\?|$)/i.test(u||'');

  const scored = _detailItems
    .filter(r => r.row_id !== item.row_id && (r.image || r.type === 'video'))
    .map(r => {
      const rTags = Array.isArray(r.tags) ? r.tags : (r.tags||'').split(',').map(t=>t.trim().toLowerCase());
      const shared = itemTags.filter(t => rTags.includes(t)).length;
      const sameCreator = r.email && r.email === item.email ? 2 : 0;
      return { item: r, score: shared * 2 + sameCreator + Math.random() };
    })
    .sort((a,b) => b.score - a.score)
    .slice(0, 6)
    .map(s => s.item);

  if (!scored.length) { container.innerHTML = ''; return; }

  const esc = s => (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  container.innerHTML = `
    <div class="detail-related-label">You might also love</div>
    <div class="detail-related-track">
      ${scored.map(r => {
        const isVid = r.type === 'video' || isVideoUrl(r.image);
        const mediaSrc = esc(r.image||'');
        const mediaEl = isVid
          ? `<video src="${mediaSrc}" muted loop playsinline autoplay
               preload="metadata" style="width:100%;height:100%;object-fit:cover;display:block;"></video>
             <span style="position:absolute;top:6px;left:6px;background:rgba(0,0,0,.45);
               color:#fff;font-size:.55rem;padding:2px 6px;border-radius:100px;
               backdrop-filter:blur(4px);pointer-events:none;">▶</span>`
          : `<img src="${mediaSrc}" alt="${esc(r.title||'')}" loading="lazy">`;
        return `
        <div class="detail-related-card" style="position:relative;" onclick="openDetail(window.__diAllItems[window.__diAllItems.findIndex(x=>x.row_id==='${esc(r.row_id)}')], window.__diAllItems, window.__diAllItems.findIndex(x=>x.row_id==='${esc(r.row_id)}'))">
          ${mediaEl}
          <div class="detail-related-card-body">
            <div class="detail-related-card-title">${esc(r.title||'Untitled')}</div>
          </div>
        </div>`;
      }).join('')}
    </div>`;
}

// Keyboard navigation
document.addEventListener('keydown', e => {
  if (!document.getElementById('inspoDetail').classList.contains('open')) return;
  if (e.key === 'Escape')     closeDetail();
  if (e.key === 'ArrowRight') navigateDetail(1);
  if (e.key === 'ArrowLeft')  navigateDetail(-1);
});

/* ── Mobile: full-screen swipe-through feed ──
   Swipe up on the image = next, swipe down = previous.
   Reuses navigateDetail(); touch-only; never preventDefaults, so
   normal scrolling of the content below is untouched. */
(function(){
  var overlay = document.getElementById('inspoDetail');
  if (!overlay) return;
  var isTouch = ('ontouchstart' in window) || navigator.maxTouchPoints > 0;
  if (!isTouch) return;

  var main = overlay.querySelector('.detail-main');
  var _origNav = window.navigateDetail;

  // Fade + slide on swap so moving through items feels like a feed
  window.navigateDetail = function(dir){
    var next = _detailIdx + dir;
    if (next < 0 || next >= _detailItems.length){
      if (main){ main.style.transition='transform .16s ease';
                 main.style.transform='translateY('+(dir<0?'10px':'-10px')+')';
                 setTimeout(function(){ main.style.transform=''; },150); }
      return;
    }
    if (!main){ _origNav(dir); return; }
    main.style.transition = 'opacity .14s ease, transform .14s ease';
    main.style.opacity = '0';
    main.style.transform = 'translateY('+(dir>0?'-16px':'16px')+')';
    setTimeout(function(){
      _origNav(dir);
      overlay.scrollTop = 0;
      main.style.transform = 'translateY('+(dir>0?'16px':'-16px')+')';
      requestAnimationFrame(function(){
        main.style.opacity = '1';
        main.style.transform = 'translateY(0)';
      });
      preloadNeighbors();
    }, 140);
  };

  function preloadNeighbors(){
    [_detailIdx+1, _detailIdx-1].forEach(function(j){
      var it = _detailItems[j];
      if (it && it.image && !/\.(mp4|webm|ogg|mov)$/i.test(it.image)){
        var im = new Image(); im.src = it.image;
      }
    });
  }

  var sx=0, sy=0, st=0, tracking=false;
  main.addEventListener('touchstart', function(e){
    if (e.target.closest('.palette-extract-btn')) return; // let the button tap through
