async function respondToListing(listingId, btn) {
  const userEmail = typeof email !== 'undefined' ? email : localStorage.getItem('userEmail') || '';
  if (!userEmail) {
    showToast('Add your email to respond'); return;
  }
  btn.disabled = true;
  try {
    const res = await fetch(SUPABASE_URL + '/rest/v1/listing_responses?apikey=' + SUPABASE_KEY, {
      method:  'POST',
      headers: {
        'apikey':        SUPABASE_KEY,
        'Authorization': 'Bearer ' + SUPABASE_KEY,
        'Content-Type':  'application/json',
        'Prefer':        'return=minimal',
      },
      body: JSON.stringify({
        listing_id:      listingId,
        responder_email: userEmail.toLowerCase(),
      }),
    });
    // 409 = duplicate unique constraint — already responded, treat as success
    if (res.status === 409) {
      btn.classList.add('responded');
      btn.textContent = '✓ Sent';
      showToast('Already sent your interest');
      return;
    }
    if (!res.ok) {
      const errBody = await res.json().catch(() => ({}));
      console.error('[respondToListing] 400 body:', errBody);
      throw new Error(errBody.message || errBody.details || errBody.hint || ('HTTP ' + res.status));
    }
    btn.classList.add('responded');
    btn.textContent = '✓ Sent';
    showToast('✦ Your interest was sent to the poster');
  } catch(e) {
    console.error('[respondToListing]', e.message);
    btn.disabled = false;
    showToast('Could not send: ' + e.message);
  }
}

