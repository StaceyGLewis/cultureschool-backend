// ── COLOR SCIENCE: CIELab + Delta-E76 ──
// Swap hexToLab / deltaE76 for CIEDE2000 later without touching callers.
function hexToLab(hex) {
  const r=parseInt(hex.slice(1,3),16)/255, g=parseInt(hex.slice(3,5),16)/255, b=parseInt(hex.slice(5,7),16)/255;
  const lin=v=>v<=0.04045?v/12.92:Math.pow((v+0.055)/1.055,2.4);
  const rl=lin(r),gl=lin(g),bl=lin(b);
  const X=(rl*0.4124564+gl*0.3575761+bl*0.1804375)/0.95047;
  const Y=(rl*0.2126729+gl*0.7151522+bl*0.0721750)/1.00000;
  const Z=(rl*0.0193339+gl*0.1191920+bl*0.9503041)/1.08883;
  const f=t=>t>0.008856?Math.cbrt(t):7.787*t+16/116;
  return [116*f(Y)-16, 500*(f(X)-f(Y)), 200*(f(Y)-f(Z))];
}
function deltaE76(lab1,lab2) {
  return Math.sqrt((lab1[0]-lab2[0])**2+(lab1[1]-lab2[1])**2+(lab1[2]-lab2[2])**2);
}
// Nearest xkcd color name — synchronous, window._XKCD_LAB is inlined above.
function nearestXkcd(hex) {
  const data=window._XKCD_LAB;
  if (!data||!data.length||!/^#[0-9a-fA-F]{6}$/i.test(hex)) return null;
  const q=hexToLab(hex);
  let bestName='',bestHex='',bestDist=Infinity;
  for (const [name,h,L,a,bv] of data) {
    const d=(q[0]-L)**2+(q[1]-a)**2+(q[2]-bv)**2;
    if (d<bestDist){bestDist=d;bestName=name;bestHex=h;}
  }
  return bestName?{name:bestName,hex:bestHex}:null;
}

function paletteDistance(queryColors, paletteColors) {
  // Delta-E76 in Lab space: for each query color, min distance to any palette swatch.
  let total = 0;
  for (const qc of queryColors) {
    const qLab = hexToLab(qc);
    let minDist = Infinity;
    for (const pc of paletteColors) {
      if (!/^#[0-9a-fA-F]{6}$/i.test(pc)) continue;
      const d = deltaE76(qLab, hexToLab(pc));
      if (d < minDist) minDist = d;
    }
    if (minDist < Infinity) total += minDist;
  }
  return total / queryColors.length;
}

