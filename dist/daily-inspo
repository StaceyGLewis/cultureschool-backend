  postMadeBtn.onclick = async function() {
    if (!userEmail) { openSignIn(); return; }

    const titleEl = get('#__mTitle');
    const title   = (titleEl && titleEl.value.trim()) || 'A moment made with CoCo';

    postMadeBtn.textContent = '⏳ Posting…';
    postMadeBtn.disabled    = true;

    // Reliable image: every social template carries a clean, CORS-safe preview in
    // asset_files. Seed imageUrl with it so posting NEVER hard-fails — especially on
    // mobile, where screenshotting arbitrary template DOM is unreliable. A live
    // desktop capture, if it succeeds, overwrites this with the richer image.
    const _tplMeta = tplMeta[activeTplKey] || {};
    let imageUrl = _tplMeta.preview || null;
    const isMobileEarly = window.matchMedia('(max-width: 640px)').matches
                       || /Mobi|Android|iPhone|iPad/i.test(navigator.userAgent);

    try {
      if (isMobileEarly) throw new Error('skip-capture-on-mobile'); // mobile posts the clean preview — instant & reliable
      // 0. Ensure html2canvas is available (lazy-load if deferred script didn't finish)
      if (typeof html2canvas === 'undefined') {
        await new Promise((resolve, reject) => {
          const s = document.createElement('script');
          s.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js';
          s.onload = resolve;
          s.onerror = reject;
          document.head.appendChild(s);
        });
      }

      // Mobile detection — phones have tight canvas memory limits
      const isMobile = window.matchMedia('(max-width: 640px)').matches
                    || /Mobi|Android|iPhone|iPad/i.test(navigator.userAgent);

      // Measure the FULL template, not just the visible scroll box.
      // #__mTplMount is overflow:auto, so without this html2canvas clips
      // everything below the fold on a phone — the core mobile bug.
      const fullW = Math.max(tplMount.scrollWidth,  tplMount.offsetWidth,  1);
      const fullH = Math.max(tplMount.scrollHeight, tplMount.offsetHeight, 1);

      // iOS Safari caps canvas area at ~16.7M px; scale big templates down
      // so the capture doesn't silently come back blank.
      let scale = isMobile ? 1.6 : 2;
      const MAX_PX = 16000000;
      if (fullW * fullH * scale * scale > MAX_PX) {
        scale = Math.max(1, Math.sqrt(MAX_PX / (fullW * fullH)));
      }

      // 1. Capture template — explicit full dimensions + un-clipped clone,
      //    wrapped in a timeout so a hung capture never freezes the button.
      const capture = html2canvas(tplMount, {
        useCORS:         true,
        allowTaint:      false,
        scale:           scale,
        backgroundColor: '#ffffff',
        logging:         false,
        imageTimeout:    8000,
        foreignObjectRendering: false,
        width:           fullW,
        height:          fullH,
        windowWidth:     fullW,
        windowHeight:    fullH,
        scrollX:         0,
        scrollY:         0,
        onclone: function(clonedDoc) {
          // Un-clip the mount in the clone so the WHOLE template renders,
          // not just the part that was visible on screen. (Forcing
          // crossorigin on every image was removed — it broke images
          // whose host sends no CORS header; useCORS handles this.)
          clonedDoc.querySelectorAll('#__mTplMount').forEach(function(el){
            el.style.overflow  = 'visible';
            el.style.maxHeight = 'none';
            el.style.height    = 'auto';
          });
        }
      });

      const timeout = new Promise((_, rej) =>
        setTimeout(() => rej(new Error('capture-timeout')), 12000));

      const canvas = await Promise.race([capture, timeout]);

      // 2. Canvas → Blob (JPEG on mobile = smaller, more reliable upload)
      const mime = isMobile ? 'image/jpeg' : 'image/png';
      const ext  = isMobile ? 'jpg' : 'png';
      const blob = await new Promise(res => canvas.toBlob(res, mime, 0.92));
      if (!blob) throw new Error('blob-failed');

      // 3. Upload to Supabase storage
      const path = `creator-posts/${userEmail}/${Date.now()}.${ext}`;
      const { data: upData, error: upErr } = await getDb().storage
        .from('public-uploads')
        .upload(path, blob, { contentType: mime, cacheControl: '3600', upsert: false });

      if (upErr) throw upErr;

      const { data: urlData } = getDb().storage.from('public-uploads').getPublicUrl(upData.path);
      imageUrl = urlData.publicUrl;

    } catch(captureErr) {
      // Mobile (capture intentionally skipped) or a failed desktop capture:
      // imageUrl is already the clean template preview, so the post still works.
      // Only warn if there's genuinely no image to attach.
      if (!/skip-capture-on-mobile/.test(String(captureErr))) console.warn('[capture] using template preview instead:', captureErr);
      if (!imageUrl) showToast('Posted without a preview image.');
    }

    // 4. Post to inspo_wall with captured image
    const { error } = await getDb().from('inspo_wall').insert([{
      title,
      image:       imageUrl,
      email:       userEmail,
      is_public:   true,
      publicwall:  true,
      type:        'Made with CoCo',
      tags:        'made with coco,template',
      featured_at: new Date().toISOString(),
    }]);

    postMadeBtn.textContent = '✦ Post this to Daily Inspo';
    postMadeBtn.disabled    = false;

    if (!error) {
      scrim.remove();
      window.__COCO_WS__ = false; window.cocoWorkspace = false;
      showCelebration(title, imageUrl);
      await loadItems();
    } else {
      showToast('Could not post — try again');
      console.error('[post made]', error);
    }
  };

  // ── Shared upload helper — raw fetch so auth token is always explicit ──
  async function uploadToCocoDrops(payload, prefix) {
    const ext  = (payload.type || 'image/jpeg').split('/')[1]?.replace('jpeg','jpg') || 'jpg';
    const name = `${prefix}-${Date.now()}-${Math.random().toString(36).slice(2,7)}.${ext}`;
    let token  = SUPABASE_KEY;
    try {
      const { data: { session } } = await getDb().auth.getSession();
      if (session?.access_token) token = session.access_token;
    } catch(_) {}
    const resp = await fetch(`${SUPABASE_URL}/storage/v1/object/coco-drops/${name}`, {
      method:  'POST',
      headers: {
        'apikey':        SUPABASE_KEY,
        'Authorization': `Bearer ${token}`,
        'Content-Type':  payload.type || 'image/jpeg',
        'x-upsert':      'false',
      },
      body: payload,
    });
    if (!resp.ok) {
      const detail = await resp.json().catch(() => ({}));
      throw new Error(detail.message || `HTTP ${resp.status}`);
    }
    return `${SUPABASE_URL}/storage/v1/object/public/coco-drops/${name}`;
  }

  // ── File upload to coco-drops ──
  const fileInput  = get('#__mFileInput');
  const dropZone   = get('#__mDropZone');
  const dropInner  = get('#__mDropInner');
  const dropPreview= get('#__mDropPreview');
  const dropImg    = get('#__mDropImg');
  // When image src is set, build the filter strip
  if (dropImg) {
    const _origSetSrc = Object.getOwnPropertyDescriptor(HTMLImageElement.prototype, 'src');
    let _prevSrc = '';
    const _checkFilterStrip = () => {
      if (dropImg.src && dropImg.src !== _prevSrc && dropImg.src !== window.location.href) {
        _prevSrc = dropImg.src;
        buildFilterStrip(dropImg.src);
        // Reset filter to none on new image
        _activeFilterIdx = 0;
        dropImg.style.filter = '';
