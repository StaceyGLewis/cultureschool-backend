/* ── SHARE TARGET HANDLER ── */
(async function() {
  // Check if we arrived via share target
  if (new URLSearchParams(location.search).get('shared') !== '1') return;

  // Clean URL without reloading
  history.replaceState({}, '', '/');

  // Wait for service worker to be ready
  if (!('caches' in window)) return;

  try {
    const cache = await caches.open('coco-share');
    const res = await cache.match('/shared-image');
    if (!res) return;

    const blob = await res.blob();
    await cache.delete('/shared-image');

    // Open the reverse lookup modal with the shared image
    openReverseLookup();

    // Simulate a file upload with the shared image
    const file = new File([blob], 'shared-image.jpg', { type: blob.type || 'image/jpeg' });
    const dt = new DataTransfer();
    dt.items.add(file);

    // Use whichever upload input exists (daily inspo vs palette page)
    const input = document.getElementById('photoUpload') || document.getElementById('rlPhotoUpload');
    if (input) {
      input.files = dt.files;
      input.dispatchEvent(new Event('change'));
    }
  } catch(e) {
    // Silently fail — share target is enhancement not requirement
  }
})();

