// Quantize image colors via canvas — no external lib needed
async function extractColorsFromImage(src, count = 5, filterCss) {
  return new Promise((resolve) => {
    const img = new Image();
    img.crossOrigin = 'anonymous';
    img.onload = () => {
      const size = 80;
      const canvas = document.createElement('canvas');
      canvas.width = canvas.height = size;
      const ctx = canvas.getContext('2d');
      // Apply cultural filter to canvas so extracted palette reflects the look
      if (filterCss && filterCss !== 'none') ctx.filter = filterCss;
      ctx.drawImage(img, 0, 0, size, size);
      ctx.filter = 'none';
      const data = ctx.getImageData(0, 0, size, size).data;

      // Sample pixels, bucket into rough color groups
      const buckets = {};
      for (let i = 0; i < data.length; i += 16) { // every 4th pixel
        const r = Math.round(data[i]   / 32) * 32;
        const g = Math.round(data[i+1] / 32) * 32;
        const b = Math.round(data[i+2] / 32) * 32;
        if (data[i+3] < 128) continue; // skip transparent
        const key = `${r},${g},${b}`;
        buckets[key] = (buckets[key] || 0) + 1;
      }

      // Sort by frequency, take top N, convert to hex
      const sorted = Object.entries(buckets)
        .sort((a, b) => b[1] - a[1])
        .slice(0, count)
        .map(([key]) => {
          const [r, g, b] = key.split(',').map(Number);
          return '#' + [r, g, b].map(v => v.toString(16).padStart(2, '0')).join('');
        });

      resolve(sorted);
    };
    img.onerror = () => resolve([]);
    img.src = src;
  });
}

async function grabPaletteFromCard(imageSrc, title, filterCss) {
  if (!imageSrc) { showToast('No image on this card'); return; }
  // Use active filter from modal if not explicitly passed
  const css = filterCss || (COCO_FILTERS[_activeFilterIdx]?.css) || 'none';
  const filterLabel = COCO_FILTERS[_activeFilterIdx]?.name;

  showToast('Extracting palette…');

  const colors = await extractColorsFromImage(imageSrc, 5, css === 'none' ? null : css);
  if (!colors.length) { showToast('Could not extract palette'); return; }

  const id = crypto?.randomUUID
    ? crypto.randomUUID()
    : String(Date.now()) + Math.random().toString(36).slice(2);

  const name = filterLabel && filterLabel !== 'Original'
    ? (title || 'Daily Inspo') + ' · ' + filterLabel
    : (title || 'Daily Inspo') + ' palette';

  // Save to Supabase palettes table
  try {
    const { error } = await getDb().from('palettes').upsert({
      id,
      name,
      colors,
      description: 'Grabbed from Daily Inspo',
      created_at: new Date().toISOString()
    }, { onConflict: 'id' });

    if (error) {
      console.warn('[grabPalette] Supabase error:', error);
      showToast('Palette saved locally only');
    } else {
      showPalettePopup({ id, name, colors, imageSrc });
    }
  } catch (e) {
    console.warn('[grabPalette] threw:', e);
    showToast('Could not save palette');
  }
}

