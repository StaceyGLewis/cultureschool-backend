function showSkeletons(n) {
  gallery.innerHTML = '';
  const heights = [180, 240, 200, 280, 160, 220, 260, 190];
  for (let i = 0; i < n; i++) {
    const el = document.createElement('div');
    el.className = 'skel-item';
    el.innerHTML = `
      <div class="skel-img" style="height:${heights[i % heights.length]}px"></div>
      <div class="skel-body">
        <div class="skel-line" style="width:40%;height:8px;margin-bottom:10px;"></div>
        <div class="skel-line" style="width:90%;"></div>
        <div class="skel-line short" style="margin-top:8px;"></div>
      </div>
    `;
    gallery.appendChild(el);
  }
}

