  const moreBtn = e.target.closest('.more-btn');
  const inMenu = menu && menu.classList.contains('show') && e.target.closest('#moreMenu');

  if (moreBtn) {
    e.stopPropagation();
    if (menu && menu.classList.contains('show')) { menu.classList.remove('show'); return; }
    openMoreMenu(moreBtn);
    return;
  }
  // Any other click closes the menu; menu-item clicks fall through
  // to their handlers below, then the menu closes too.
  if (menu && menu.classList.contains('show')) {
    setTimeout(() => menu.classList.remove('show'), 40);
    if (!inMenu) { /* outside click — just close */ }
  }

  const collectBtn = e.target.closest('.collect-btn');
  const clapBtn    = e.target.closest('.clap-btn');

  if (collectBtn) {
    e.stopPropagation();
    const item = {
      title:         collectBtn.dataset.title,
      image:         collectBtn.dataset.image,
      source_url:    collectBtn.dataset.source,
      creator_email: collectBtn.dataset.creatorEmail || '',
    };
    collectItem(collectBtn, item);
    return;
  }
  if (clapBtn) {
    e.stopPropagation();
    const item = {
      image:      clapBtn.dataset.image,
      source_url: clapBtn.dataset.source,
    };
    handleClap(clapBtn, item);
    return;
  }

  const nudgeBtn = e.target.closest('.nudge-btn');
  if (nudgeBtn) {
    showNudge(nudgeBtn.dataset.title, nudgeBtn.dataset.image, nudgeBtn.dataset.source, nudgeBtn.dataset.rowId);
    return;
  }

  const shareBtn = e.target.closest('.share-btn');
  if (shareBtn) {
    e.stopPropagation();
    showCardShare(shareBtn.dataset.title, shareBtn.dataset.source, shareBtn.dataset.rowId);
    return;
  }

  const pinBtn = e.target.closest('.pin-btn');
  if (pinBtn) {
    e.stopPropagation();
    const title = pinBtn.dataset.title || 'A color story';
    const img   = pinBtn.dataset.image || '';
    // Link back to a PUBLIC page so a pin drags strangers to us, never the private vault.
    const back  = pinBtn.dataset.source || 'https://coco-daily-inspo.cultureschool.org/';
    // Keep the provenance attached — the pin description is our one shot at it.
    const desc  = title + ' — a cultural color story from CultureSchool. Named, rooted, and credited. #CultureSchool #ColorStory';
    if (!img) { showToast('No image to pin'); return; }
    const pinUrl = 'https://www.pinterest.com/pin/create/button/'
      + '?url='         + encodeURIComponent(back)
      + '&media='       + encodeURIComponent(img)
      + '&description=' + encodeURIComponent(desc);
    window.open(pinUrl, '_blank', 'noopener,width=750,height=560');
    return;
  }

  const storyBtn = e.target.closest('.story-btn');
  if (storyBtn) {
    e.stopPropagation();
    makeStoryCard({
      title:   storyBtn.dataset.title,
      caption: storyBtn.dataset.caption,
      image:   storyBtn.dataset.image,
    }, storyBtn);
    return;
  }
});

/* ══════════════════════════════════════════════════════
   STORY CARD GENERATOR
   Composites card image + title + CoCo branding onto
   a 1080x1920 (9:16) canvas for Instagram Stories.
   Downloads as PNG or fires Web Share API on mobile.
══════════════════════════════════════════════════════ */
async function makeStoryCard(item, btn) {
  if (!item.image) { showToast('This card has no image'); return; }

  const origText = btn.textContent;
  btn.textContent = 'Building…';
  btn.disabled = true;

  try {
    const W = 1080, H = 1920;
    const canvas = document.createElement('canvas');
    canvas.width = W; canvas.height = H;
    const ctx = canvas.getContext('2d');

    // Load image
    const img = await loadCrossOriginImage(item.image);

    // Full bleed background
    const scale = Math.max(W / img.width, H / img.height);
    const iw = img.width * scale, ih = img.height * scale;
    ctx.drawImage(img, (W - iw) / 2, (H - ih) / 2, iw, ih);

    // Lighter gradient — image stays the hero, text is readable not dominant
    const grad = ctx.createLinearGradient(0, H * 0.5, 0, H);
    grad.addColorStop(0,   'rgba(14,10,4,0)');
    grad.addColorStop(0.5, 'rgba(14,10,4,0.35)');
    grad.addColorStop(1,   'rgba(14,10,4,0.72)');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, W, H);

    // Gold top bar
    ctx.fillStyle = '#d4af37';
    ctx.fillRect(0, 0, W, 8);

    // CoCo wordmark
    ctx.textAlign = 'left';
    ctx.font = '500 52px Georgia, serif';
    ctx.fillStyle = 'rgba(212,175,55,0.9)';
    ctx.fillText('CoCo', 72, 100);
    ctx.font = '400 30px Georgia, serif';
    ctx.fillStyle = 'rgba(212,175,55,0.5)';
    ctx.fillText('Daily Inspo · CultureSchool', 72, 142);

    // Divider
    ctx.strokeStyle = 'rgba(212,175,55,0.2)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(72, 164); ctx.lineTo(W - 72, 164); ctx.stroke();

    // Title
    const title = item.title || '';
    if (title) {
      ctx.font = 'italic 700 88px Georgia, serif';
      ctx.fillStyle = '#fff1b8';
      ctx.textAlign = 'center';
      ctx.shadowColor = 'rgba(0,0,0,0.6)';
      ctx.shadowBlur = 18;
      const words = title.split(' ');
      const lines = [];
      let line = '';
      for (const word of words) {
        const test = line ? line + ' ' + word : word;
        if (ctx.measureText(test).width > W - 144) { if (line) lines.push(line); line = word; }
        else line = test;
      }
      if (line) lines.push(line);
      const lineH = 108;
      let startY = H - 320 - lines.length * lineH;
      lines.forEach((l, i) => ctx.fillText(l, W / 2, startY + i * lineH));
      ctx.shadowBlur = 0;
    }

    // Caption
    if (item.caption) {
      const cap = item.caption.length > 100 ? item.caption.slice(0, 97) + '…' : item.caption;
      ctx.font = 'italic 400 42px Georgia, serif';
      ctx.fillStyle = 'rgba(245,241,232,0.65)';
      ctx.textAlign = 'center';
      ctx.shadowColor = 'rgba(0,0,0,0.9)';
      ctx.shadowBlur = 20;
      ctx.fillText(cap, W / 2, H - 210);
      ctx.shadowBlur = 0;
    }

    // URL
    ctx.font = '400 32px Arial, sans-serif';
    ctx.fillStyle = 'rgba(212,175,55,0.55)';
    ctx.textAlign = 'center';
    ctx.fillText('coco-daily-inspo.cultureschool.org', W / 2, H - 90);

    // Gold bottom bar
    ctx.fillStyle = '#d4af37';
    ctx.fillRect(0, H - 8, W, 8);

    // Export
    const blob = await new Promise(res => canvas.toBlob(res, 'image/png'));
    const url  = URL.createObjectURL(blob);
    const file = new File([blob], 'coco-story.png', { type: 'image/png' });

    if (navigator.canShare && navigator.canShare({ files: [file] })) {
      await navigator.share({ title: 'CoCo Daily Inspo', files: [file] });
    } else {
      const a = document.createElement('a');
      a.href = url; a.download = 'coco-story.png'; a.click();
      showToast('❆ Story card downloaded — add to your Instagram Story');
    }
    URL.revokeObjectURL(url);

  } catch(err) {
    console.error('[story]', err);
    showToast('Could not build story card — try again');
  } finally {
    btn.textContent = origText;
    btn.disabled = false;
  }
}

function loadCrossOriginImage(src) {
  return new Promise((resolve, reject) => {
    const img = new Image();
    img.crossOrigin = 'anonymous';
    img.onload  = () => resolve(img);
    img.onerror = () => {
      const img2 = new Image();
      img2.onload  = () => resolve(img2);
      img2.onerror = reject;
      img2.src = src;
    };
    img.src = src + (src.includes('?') ? '&' : '?') + '_cb=' + Date.now();
  });
}


