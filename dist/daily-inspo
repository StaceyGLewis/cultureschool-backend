const VOICEBOARD_BASE = (window.VOICEBOARD_URL || 'https://voiceboard-viewer.cultureschool.org').replace(/\/+$/, '') + '/';

function voiceboardHref({ email, board, media, mode } = {}) {
  const u = new URL(VOICEBOARD_BASE);
  if (email) u.searchParams.set('email', email);
  if (board) u.searchParams.set('board', board);
  if (media) u.searchParams.set('media', media);
  if (mode === 'collect') u.searchParams.set('collect', '1');
  return u.toString();
}

window.collectItem = async function collectItem(btn, item) {
  if (btn) { btn.disabled = true; }
  const prevText = btn ? btn.textContent : '';
  if (btn) btn.textContent = '…';

  try {
    let email = getUserEmail();
    if (!email) {
      // Remember what they were saving; submitSignIn resumes it
      // automatically the moment an email is entered.
      window.__pendingCollect = item;
      if (btn) { btn.disabled = false; btn.textContent = prevText; }
      openSignIn();
      showToast('Enter your email and this saves to your Vault ✦');
      return;
    }

    const { error } = await getDb()
      .from('collector_items')
      .insert({
        title:         item.title || 'Untitled',
        image_url:     item.image || null,
        source_url:    item.source_url || null,
        notes:         '',
        email:         email,
        creator_email: email,
        type:          'image',
        collected_at:  new Date().toISOString(),
      });

    if (error) throw error;

    if (btn) btn.textContent = '✦ Saved';
    showActionToast('✦ Saved —', 'View in Vault',
      voiceboardHref({ email, mode: 'collect' }));

    // ── Notify the original creator ──────────────────────────
    // Best-effort and fully isolated: a notification hiccup must
    // never make a successful save look like a failure.
    try {
      const originalCreator = item.creator_email;
      if (originalCreator && originalCreator !== email) {
        let city = null;
        try {
          const geo = await fetch('https://ipapi.co/json/');
          if (geo.ok) { const d = await geo.json(); city = d.city || null; }
        } catch(_) {}

        await getDb().from('creator_notifications').insert({
          creator_email: originalCreator,
          type:          'save',
          actor_email:   email,
          actor_location: city,
          post_title:    item.title || null,
          post_image:    item.image || null,
          read:          false,
        });
      }
    } catch(notifyErr) {
      console.warn('[collect] notify failed (save was fine):', notifyErr);
    }

  } catch(err) {
    console.error('[collect]', err);
    if (btn) btn.textContent = prevText;
    showToast('Could not save — please try again.');
  } finally {
    if (btn) btn.disabled = false;
  }
}

/* ── PUBLIC REACTIONS (hearts) — collector_reactions table ──
   item_id = inspo_wall.row_id. Identity = signed-in email, or a
   persistent per-device anonymous id, so liking is truly one tap
   with zero sign-up friction. The unique index on
   (item_id, user_email, reaction_type) makes double-likes
   impossible server-side. */

function reactorId() {
  const email = getUserEmail();
  if (email) return email;
  let anon = localStorage.getItem('cocoDeviceId');
  if (!anon) {
    anon = 'anon:' + (crypto.randomUUID ? crypto.randomUUID()
      : Date.now().toString(36) + Math.random().toString(36).slice(2));
    localStorage.setItem('cocoDeviceId', anon);
  }
  return anon;
}

const heartCounts = {};   // row_id → count
const myHearts    = {};   // row_id → true

window.handleClap = async function handleClap(btn, item) {
  const rowId = btn.dataset.rowId;
  if (!rowId) return;
  btn.disabled = true;

  const me = reactorId();
  const hearted = btn.classList.contains('clapped');

  // Optimistic UI — flip instantly, reconcile on failure
  setHeartUI(rowId, !hearted, (heartCounts[rowId] || 0) + (hearted ? -1 : 1));

  try {
    if (hearted) {
      const { error } = await getDb()
        .from('collector_reactions')
        .delete()
        .eq('item_id', rowId)
        .eq('user_email', me)
        .eq('reaction_type', 'heart');
      if (error) throw error;
      myHearts[rowId] = false;
    } else {
      const { error } = await getDb()
        .from('collector_reactions')
        .insert({ item_id: rowId, user_email: me, reaction_type: 'heart' });
      // 23505 = unique violation — already hearted elsewhere; treat as success
      if (error && error.code !== '23505') throw error;
      myHearts[rowId] = true;
    }
  } catch(err) {
    console.error('[heart]', err);
    // roll back the optimistic flip
    setHeartUI(rowId, hearted, (heartCounts[rowId] || 0) + (hearted ? 1 : -1));
  } finally {
    btn.disabled = false;
  }
}

function setHeartUI(rowId, hearted, count) {
  heartCounts[rowId] = Math.max(0, count || 0);
  document.querySelectorAll(`.clap-btn[data-row-id="${CSS.escape(rowId)}"]`)
    .forEach(b => b.classList.toggle('clapped', !!hearted));
  document.querySelectorAll(`.heart-count[data-count-for="${CSS.escape(rowId)}"]`)
    .forEach(s => {
      s.textContent = heartCounts[rowId] > 0 ? heartCounts[rowId] : '';
      // Show/hide the card-level heart display
      const card = document.getElementById('chd-' + rowId);
      if (card) card.style.display = heartCounts[rowId] > 0 ? 'flex' : 'none';
    });
}

// Batch-load counts + my own hearts after the wall renders, so
// liked state and numbers survive refresh.
async function loadHearts(items) {
  const ids = (items || []).map(i => i.row_id).filter(Boolean);
  if (!ids.length) return;
  try {
    const me = reactorId();
    const { data, error } = await getDb()
      .from('collector_reactions')
      .select('item_id,user_email')
      .eq('reaction_type', 'heart')
      .in('item_id', ids);
    if (error) throw error;

    const counts = {}, mine = {};
    (data || []).forEach(r => {
      counts[r.item_id] = (counts[r.item_id] || 0) + 1;
      if (r.user_email === me) mine[r.item_id] = true;
    });
    ids.forEach(id => {
      myHearts[id] = !!mine[id];
      setHeartUI(id, mine[id], counts[id] || 0);
    });
  } catch(err) {
    console.warn('[hearts] load failed', err);
  }
}

