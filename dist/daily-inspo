/* ── FILTER ── */
function getFiltered() {
  const q = (searchInput.value || '').toLowerCase().trim();
  return allItems.filter(item => {
    const text = [item.title, item.caption, item.type].join(' ').toLowerCase();
    const matchQ = !q || text.includes(q);
    const matchF = activeFilter === 'all' || (() => {
      if (activeFilter === 'dotube') {
        const src = item.image || '';
        const isVideoSrc = /\.(mp4|webm|ogg|mov)(\?|$)/i.test(src) ||
                           /youtu\.be\/|youtube\.com\/watch|youtube\.com\/shorts/i.test(src);
        const taggedDotube = (Array.isArray(item.tags) ? item.tags.join(' ') : String(item.tags || '')).toLowerCase().includes('dotube');
        return isVideoSrc || taggedDotube;
      }
      const f = activeFilter.toLowerCase();
      const inType = (item.type || '').toLowerCase().includes(f);
      const inTags = (Array.isArray(item.tags) ? item.tags.join(' ') : String(item.tags || '')).toLowerCase().includes(f);
      return inType || inTags;
    })();
    return matchQ && matchF;
  });
}

