/* ══════════════════════════════════════════════════════
   PATTERN GENERATOR SHARE INTAKE
   Reads ?source=pattern params, generates a palette
   swatch image, uploads to coco-drops, then shows a
   banner offering to open the Daily Inspo composer
   pre-filled with the pattern's name, origin + swatch.
══════════════════════════════════════════════════════ */
(function handlePatternShare() {
  const p = new URLSearchParams(location.search);
  if (p.get('source') !== 'pattern') return;

  // Clean URL immediately
  history.replaceState({}, '', location.pathname);

  const colors   = (p.get('colors') || '').split(',').filter(c => /^#[0-9a-fA-F]{6}$/.test(c));
  const name     = p.get('name')   || 'CoCo Pattern';
  const style    = p.get('style')  || '';
  const origin   = p.get('origin') || '';
  const palId    = p.get('palette_id') || null;
  const title    = style ? `${name} · ${style[0].toUpperCase() + style.slice(1)}` : name;

  if (!colors.length) return;

  // Store pending share data — the banner CTA and btnShare click both read this
  window.__pendingPatternShare = { title, origin, colors, palId, imageUrl: null };

  // Build banner immediately (image uploads in background)
  const banner = document.createElement('div');
  banner.className = 'pattern-share-banner';
  banner.id = 'patternShareBanner';
  banner.innerHTML = `
    <div class="pattern-share-banner-swatch">
      ${colors.slice(0,5).map(c => `<i style="background:${c}"></i>`).join('')}
    </div>
    <div class="pattern-share-banner-info">
      <div class="pattern-share-banner-eyebrow">From Pattern Generator</div>
      <div class="pattern-share-banner-title">${title.replace(/</g,'&lt;')}</div>
      ${origin ? `<div class="pattern-share-banner-origin">${origin.replace(/</g,'&lt;')}</div>` : ''}
    </div>
    <button class="pattern-share-banner-cta" id="patternSharePost">
      ✦ Add to Daily Inspo
    </button>
    <button class="pattern-share-banner-dismiss" id="patternShareDismiss" title="Dismiss">✕</button>`;
  document.body.prepend(banner);

  document.getElementById('patternShareDismiss').onclick = () => banner.remove();
  document.getElementById('patternSharePost').onclick    = () => {
    banner.remove();
    // Trigger the main share modal (same as clicking the share button)
    const shareBtn = document.getElementById('btnShare') ||
                     document.querySelector('[id*="Share"],[id*="share"],[class*="share-btn"]');
    if (shareBtn) shareBtn.click();
  };

  // Generate palette swatch PNG and upload in background
  (async () => {
    try {
      const W = 1200, H = 400;
      const cv = document.createElement('canvas');
      cv.width = W; cv.height = H;
      const ctx = cv.getContext('2d');
      const sliceW = Math.floor(W / colors.length);
      colors.forEach((col, i) => {
        ctx.fillStyle = col;
        ctx.fillRect(i * sliceW, 0, i === colors.length - 1 ? W - i * sliceW : sliceW, H);
      });
      // Watermark
      ctx.font = '500 22px Arial, sans-serif';
      const label = 'cultureschool.org';
      const tw = ctx.measureText(label).width;
      const pw = tw + 16, ph = 34;
      const px = W - pw - 8, py = H - ph - 8;
      ctx.fillStyle = 'rgba(0,0,0,.2)';
      ctx.beginPath(); ctx.roundRect(px,py,pw,ph,ph/2); ctx.fill();
      ctx.fillStyle = 'rgba(255,255,255,.8)';
      ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
      ctx.fillText(label, W - 16, py + ph / 2);

      const blob = await new Promise(res => cv.toBlob(res, 'image/png'));
      if (!blob) return;

      const db = typeof getDb === 'function' ? getDb() : null;
      if (!db) return;
      const fname = `pattern-share-${Date.now()}.png`;
      const { error } = await db.storage.from('coco-drops').upload(fname, blob, { contentType: 'image/png', upsert: true });
      if (error) return;
      const { data: urlData } = db.storage.from('coco-drops').getPublicUrl(fname);
      const imageUrl = urlData?.publicUrl;
      if (imageUrl && window.__pendingPatternShare) {
        window.__pendingPatternShare.imageUrl = imageUrl;
      }
    } catch(e) { console.warn('[patternShare] swatch upload:', e); }
  })();
})();

