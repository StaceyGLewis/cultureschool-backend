  { label:'Denim jacket back panel', url:'https://cultureschool.org/products/denim-jacket-panel-sewing-pattern-pdf-download' },
];

/* ---------- Buy it made (textile composited onto finished products) ---------- */
const ORDER_PRODUCTS = {
  pillow:{ label:'Pillow 22×22', url:'https://cultureschool.org/products/coco-print-22-x-22-pillow', img:'https://cdn.shopify.com/s/files/1/0673/3637/2387/files/square_22_x_22_pillow_mockup.png?v=1777999891', patRect:[30,30,140,140] },
  tote:{ label:'Tote Bag', url:'https://cultureschool.org/products/coco-print-tote', img:'https://cdn.shopify.com/s/files/1/0673/3637/2387/files/extra_large_rectangular_tote_bag_mockup_floating_on_a_blank__2_-removebg-preview.png?v=1777999364', patRect:[35,20,130,130] },
  sheets:{ label:'Sheet Set', url:'https://cultureschool.org/products/coco-print-sheet-set', img:'https://cdn.shopify.com/s/files/1/0673/3637/2387/files/Folded_Sheet_Set_Mock_Up.png?v=1778003351', patRect:[15,8,180,95] },
};
const _mockCache = {};
let _activeTextileImg = null;
function preloadMockups(){ Object.keys(ORDER_PRODUCTS).forEach(function(k){ var im=new Image(); im.crossOrigin='anonymous'; im.onload=function(){ _mockCache[k]=im; redrawBuyMockups(); }; im.src=ORDER_PRODUCTS[k].img; }); }
function drawTextileMockup(canvas, tex, key){
  var prod=ORDER_PRODUCTS[key]; if(!prod) return;
  var ctx=canvas.getContext('2d'), W=canvas.width, H=canvas.height; ctx.clearRect(0,0,W,H);
  var photo=_mockCache[key], r=prod.patRect;
  var off=document.createElement('canvas'); off.width=W; off.height=H; var oc=off.getContext('2d');
  oc.fillStyle='#fff'; oc.fillRect(0,0,W,H);
  if(tex && tex.complete && tex.naturalWidth) oc.drawImage(tex, r[0],r[1],r[2],r[3]);
  if(photo && photo.complete){ oc.globalCompositeOperation='multiply'; oc.drawImage(photo,0,0,W,H); oc.globalCompositeOperation='destination-in'; oc.drawImage(photo,0,0,W,H); oc.globalCompositeOperation='source-over'; }
  ctx.drawImage(off,0,0);
}
function redrawBuyMockups(){ Object.keys(ORDER_PRODUCTS).forEach(function(k){ var c=document.getElementById('bm-'+k); if(c) drawTextileMockup(c,_activeTextileImg,k); }); }
function renderBuyGrid(a){
  var grid=document.getElementById('buyGrid'); if(!grid) return;
  grid.innerHTML=Object.keys(ORDER_PRODUCTS).map(function(k){ var p=ORDER_PRODUCTS[k]; return '<a class="buy-card" href="'+p.url+'" target="_blank" rel="noopener"><canvas id="bm-'+k+'" width="210" height="150"></canvas><div class="bc-name">'+p.label+'</div></a>'; }).join('');
  _activeTextileImg=null; redrawBuyMockups();
  if(a && a.image_url){ var im=new Image(); im.crossOrigin='anonymous'; im.onload=function(){ _activeTextileImg=im; redrawBuyMockups(); }; im.src=a.image_url; }
}
function openMakeModal(id){
  const a = (typeof ALL !== 'undefined' ? ALL : []).find(x => String(x.id) === String(id));
  document.getElementById('makeTitle').textContent = a ? ('Make with \u201c' + a.title + '\u201d') : 'Make it yourself';
  document.getElementById('makeList').innerHTML =
    '<a class="make-fabric mr-chip mr-primary" href="' + SPOONFLOWER_SHOP + '" target="_blank" rel="noopener">Get the fabric \u2014 Spoonflower \u2192</a>'
    + MAKE_PROJECTS.map(function(pj){ return '<div class="make-row"><span class="mr-name">' + esc(pj.label) + '</span><span class="mr-acts"><a class="mr-chip mr-primary" href="' + pj.url + '" target="_blank" rel="noopener">Pattern PDF \u2192</a><span class="mr-chip mr-soon">Kit \u00b7 soon</span></span></div>'; }).join('');
  renderBuyGrid(a);
  openModal('make');
}

preloadMockups();
load();
